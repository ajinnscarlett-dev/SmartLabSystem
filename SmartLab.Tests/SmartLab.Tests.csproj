<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.29" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartLab.Server\SmartLab.Server.csproj" />
    <ProjectReference Include="..\SmartLab.Shared\SmartLab.Shared.csproj" />
  </ItemGroup>

  <!-- Exercise the actual platform-neutral client networking code on every test host. -->
  <ItemGroup>
    <Compile Include="../SmartLab.Client/ThumbnailRefreshPolicy.cs" Link="Client/ThumbnailRefreshPolicy.cs" />
    <Compile Include="../SmartLab.Client/MachinePresenceService.cs" Link="Client/MachinePresenceService.cs" />
    <Compile Include="../SmartLab.Client/SmartLabServerConfig.cs" Link="Client/SmartLabServerConfig.cs" />
    <Compile Include="../SmartLab.Client/PCConfig.cs" Link="Client/PCConfig.cs" />
    <Compile Include="../SmartLab.Client/AuthSession.cs" Link="Client/AuthSession.cs" />
    <Compile Include="../SmartLab.Client/ClientLog.cs" Link="Client/ClientLog.cs" />
  </ItemGroup>

</Project>
