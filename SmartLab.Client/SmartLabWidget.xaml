<Window x:Class="SmartLab.Client.SmartLabWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab"
        Width="270"
        Height="155"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#E8F0F8"
            CornerRadius="12"
            BorderBrush="#B8C7D9"
            BorderThickness="1"
            Padding="12">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0">

                <TextBlock Text="SmartLab"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#182536"
                           HorizontalAlignment="Left"/>

                <TextBlock x:Name="PcNumberText"
                           Text="PC-01"
                           FontSize="11"
                           Foreground="#5A6B7D"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- USERNAME -->
            <TextBlock x:Name="UsernameText"
                       Grid.Row="1"
                       Text="student01"
                       FontSize="12"
                       Foreground="#4B5D70"
                       Margin="0,5,0,5"/>

            <!-- ACTIONS -->
            <Grid Grid.Row="2"
                  Margin="0,0,0,8">

                <Button x:Name="NotificationButton"
                        Content="NOTIFICATIONS"
                        Width="125"
                        Height="28"
                        HorizontalAlignment="Left"
                        Click="NotificationButton_Click"/>

                <Border x:Name="NotificationCountBadge"
                        Width="20"
                        Height="20"
                        CornerRadius="10"
                        Background="#C62828"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="112,-7,0,0"
                        Visibility="Collapsed">

                    <TextBlock x:Name="NotificationCountText"
                               Text="0"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>
                </Border>

                <Button x:Name="LogoutButton"
                        Content="Logout"
                        Width="65"
                        Height="28"
                        HorizontalAlignment="Right"
                        Click="LogoutButton_Click"/>
            </Grid>

            <!-- STATUS -->
            <TextBlock Grid.Row="3"
                       Text="Announcements &amp; notifications are checked automatically."
                       FontSize="9"
                       Foreground="#6B7D90"/>

        </Grid>

    </Border>

</Window>
