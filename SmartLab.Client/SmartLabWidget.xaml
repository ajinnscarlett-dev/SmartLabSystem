<Window x:Class="SmartLab.Client.SmartLabWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab"
        Width="340" Height="190"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="{StaticResource SmartLabSurface}" BorderBrush="{StaticResource SmartLabBorder}"
            BorderThickness="1" Padding="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SMARTLAB" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="WORKSTATION" Style="{StaticResource SmartLabCaption}" Margin="0,1,0,0"/>
                </StackPanel>
                <TextBlock x:Name="PcNumberText" Grid.Column="1" Text="PC-01"
                           FontSize="11" Foreground="{StaticResource SmartLabAccent}"
                           VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="UsernameText" Grid.Row="1" Text="student01"
                       FontSize="12" Foreground="{StaticResource SmartLabText}"
                       Margin="0,8,0,9"/>

            <Grid Grid.Row="2" Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Button x:Name="NotificationButton" Content="NOTIFICATIONS" Height="31"
                            Click="NotificationButton_Click"/>
                    <Border x:Name="NotificationCountBadge" Width="18" Height="18" CornerRadius="9"
                            Background="{StaticResource SmartLabDanger}" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,-5,-4,0" Visibility="Collapsed">
                        <TextBlock x:Name="NotificationCountText" Text="0" FontSize="9" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <Button Grid.Column="1" x:Name="NeedAssistanceButton" Content="NEED HELP" Height="31"
                        Margin="7,0,0,0" Style="{StaticResource SmartLabPrimaryButton}"
                        Click="NeedAssistanceButton_Click"/>
                <Button Grid.Column="2" x:Name="LogoutButton" Content="LOGOUT" Width="68" Height="31"
                        Margin="7,0,0,0" Style="{StaticResource SmartLabDangerButton}"
                        Click="LogoutButton_Click"/>
            </Grid>

            <TextBlock x:Name="ConnectionStatusText" Grid.Row="3"
                       Text="Connected • workstation presence active"
                       Style="{StaticResource SmartLabCaption}"/>
        </Grid>
    </Border>
</Window>