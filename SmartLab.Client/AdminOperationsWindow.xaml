<Window x:Class="SmartLab.Client.AdminOperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Operations Center"
        Width="1460" Height="900" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}"
        FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="OPERATIONS CENTER" Style="{StaticResource SmartLabPageTitle}"/>
                <TextBlock Text="Database-backed tools for usage, maintenance, inventory, assistance, announcements, archive, and exports."
                           Style="{StaticResource SmartLabCaption}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Style="{StaticResource SmartLabCaption}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <Button Content="REFRESH ALL" Style="{StaticResource SmartLabPrimaryButton}" Width="108" Click="RefreshAll_Click"/>
                <Button Content="CLOSE" Width="80" Margin="8,0,0,0" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SmartLabSectionBorder}" Padding="0">
            <TabControl x:Name="OperationsTabs" Style="{StaticResource SmartLabTabItem}">
                <TabItem Header="OVERVIEW">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SmartLabToolbarBorder}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="SESSION ACTIVITY" Style="{StaticResource SmartLabCaption}"/>
                                        <TextBlock x:Name="TotalSessionsText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <TextBlock Text="Total sessions" Style="{StaticResource SmartLabCaption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource SmartLabToolbarBorder}" Margin="6,0">
                                    <StackPanel>
                                        <TextBlock Text="UTILIZATION" Style="{StaticResource SmartLabCaption}"/>
                                        <TextBlock x:Name="UtilizationText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="AvgSessionText" Text="Average session —" Style="{StaticResource SmartLabCaption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource SmartLabToolbarBorder}" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="SYSTEM EVENTS" Style="{StaticResource SmartLabCaption}"/>
                                        <TextBlock x:Name="OfflineEventsText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="MaintenanceEventsText" Text="Maintenance —" Style="{StaticResource SmartLabCaption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SmartLabSectionBorder}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="MOST USED" Style="{StaticResource SmartLabSectionTitle}"/>
                                        <TextBlock x:Name="MostUsedPcText" Text="PC —" Margin="0,10,0,2"/>
                                        <TextBlock x:Name="MostUsedLabText" Text="Laboratory —"/>
                                        <TextBlock x:Name="PeakHourText" Text="Peak hour —" Style="{StaticResource SmartLabCaption}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource SmartLabSectionBorder}" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="CURRENT PC HEALTH" Style="{StaticResource SmartLabSectionTitle}"/>
                                        <UniformGrid Columns="4" Margin="0,10,0,0">
                                            <StackPanel><TextBlock Text="Available" Style="{StaticResource SmartLabCaption}"/><TextBlock x:Name="HealthAvailableText" Text="—" FontSize="17"/></StackPanel>
                                            <StackPanel><TextBlock Text="Occupied" Style="{StaticResource SmartLabCaption}"/><TextBlock x:Name="HealthOccupiedText" Text="—" FontSize="17"/></StackPanel>
                                            <StackPanel><TextBlock Text="Offline" Style="{StaticResource SmartLabCaption}"/><TextBlock x:Name="HealthOfflineText" Text="—" FontSize="17"/></StackPanel>
                                            <StackPanel><TextBlock Text="Maintenance" Style="{StaticResource SmartLabCaption}"/><TextBlock x:Name="HealthMaintenanceText" Text="—" FontSize="17"/></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource SmartLabSectionBorder}">
                                <StackPanel>
                                    <TextBlock Text="SYSTEM HEALTH" Style="{StaticResource SmartLabSectionTitle}"/>
                                    <TextBlock x:Name="SystemHealthText" Text="Checking server and SQL Server…" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="SystemHealthDetailText" Style="{StaticResource SmartLabCaption}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="USAGE HISTORY">
                    <DockPanel Margin="12">
                        <Border DockPanel.Dock="Top" Style="{StaticResource SmartLabToolbarBorder}" Margin="0,0,0,10">
                            <WrapPanel>
                                <DatePicker x:Name="UsageFrom" Margin="0,0,8,0"/>
                                <DatePicker x:Name="UsageTo" Margin="0,0,8,0"/>
                                <ComboBox x:Name="UsageLabCombo" Width="165"/>
                                <ComboBox x:Name="UsagePcCombo" Width="140"/>
                                <ComboBox x:Name="UsageUserCombo" Width="165"/>
                                <Button Content="APPLY FILTERS" Style="{StaticResource SmartLabPrimaryButton}" Click="LoadUsage_Click"/>
                                <Button Content="EXPORT CSV" Click="ExportUsage_Click"/>
                            </WrapPanel>
                        </Border>
                        <DataGrid x:Name="UsageGrid" Style="{StaticResource SmartLabDataGrid}"/>
                    </DockPanel>
                </TabItem>

                <TabItem Header="MAINTENANCE">
                    <DockPanel Margin="12">
                        <Border DockPanel.Dock="Top" Style="{StaticResource SmartLabToolbarBorder}" Margin="0,0,0,10">
                            <WrapPanel>
                                <ComboBox x:Name="MaintenancePcCombo" Width="180"/>
                                <TextBox x:Name="MaintenanceReasonText" Width="260" Text="Maintenance required"/>
                                <Button Content="START MAINTENANCE" Style="{StaticResource SmartLabPrimaryButton}" Click="StartMaintenance_Click"/>
                                <Button Content="CLEAR MAINTENANCE" Click="ClearMaintenance_Click"/>
                                <Button Content="REFRESH" Click="LoadMaintenance_Click"/>
                                <Button Content="EXPORT CSV" Click="ExportMaintenance_Click"/>
                            </WrapPanel>
                        </Border>
                        <DataGrid x:Name="MaintenanceGrid" Style="{StaticResource SmartLabDataGrid}"/>
                    </DockPanel>
                </TabItem>

                <TabItem Header="HARDWARE INVENTORY">
                    <DockPanel Margin="12">
                        <Border DockPanel.Dock="Top" Style="{StaticResource SmartLabToolbarBorder}" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="REFRESH INVENTORY" Click="LoadInventory_Click"/>
                                <Button Content="EXPORT CSV" Margin="8,0,0,0" Click="ExportInventory_Click"/>
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="InventoryGrid" Style="{StaticResource SmartLabDataGrid}"/>
                    </DockPanel>
                </TabItem>

                <TabItem Header="ASSISTANCE QUEUE">
                    <DockPanel Margin="12">
                        <Border DockPanel.Dock="Top" Style="{StaticResource SmartLabToolbarBorder}" Margin="0,0,0,10">
                            <WrapPanel>
                                <ComboBox x:Name="AssistanceLabCombo" Width="175"/>
                                <ComboBox x:Name="AssistanceStatusCombo" Width="145"/>
                                <Button Content="LOAD QUEUE" Style="{StaticResource SmartLabPrimaryButton}" Click="LoadAssistance_Click"/>
                                <Button Content="ACKNOWLEDGE" Margin="8,0,0,0" Click="AcknowledgeAssistance_Click"/>
                                <Button Content="IN PROGRESS" Click="StartAssistance_Click"/>
                                <Button Content="RESOLVE" Click="ResolveAssistance_Click"/>
                                <Button Content="CLOSE" Click="CloseAssistance_Click"/>
                            </WrapPanel>
                        </Border>
                        <DataGrid x:Name="AssistanceGrid" Style="{StaticResource SmartLabDataGrid}" SelectionMode="Single"/>
                    </DockPanel>
                </TabItem>

                <TabItem Header="ANNOUNCEMENTS">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource SmartLabToolbarBorder}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions>
                                <TextBlock Text="TITLE" Style="{StaticResource SmartLabCaption}" VerticalAlignment="Center"/>
                                <TextBox x:Name="AnnouncementTitleText" Grid.Column="1"/>
                                <TextBlock Text="TARGET ROLE" Grid.Column="2" Style="{StaticResource SmartLabCaption}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="AnnouncementRoleCombo" Grid.Column="3"/>
                                <TextBlock Text="EXPIRES" Grid.Row="1" Style="{StaticResource SmartLabCaption}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <DatePicker x:Name="AnnouncementExpiry" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"/>
                                <TextBlock Text="MESSAGE" Grid.Row="2" Style="{StaticResource SmartLabCaption}" VerticalAlignment="Top" Margin="0,12,0,0"/>
                                <TextBox x:Name="AnnouncementMessageText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Height="70" Margin="0,8,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="CREATE" Style="{StaticResource SmartLabPrimaryButton}" Click="CreateAnnouncement_Click"/>
                                    <Button Content="DEACTIVATE SELECTED" Style="{StaticResource SmartLabDangerButton}" Click="DeactivateAnnouncement_Click"/>
                                    <Button Content="REFRESH" Click="LoadAnnouncements_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataGrid Grid.Row="1" x:Name="AnnouncementGrid" Style="{StaticResource SmartLabDataGrid}" SelectionMode="Single"/>
                    </Grid>
                </TabItem>

                <TabItem Header="ARCHIVE">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource SmartLabToolbarBorder}" Margin="0,0,0,12">
                            <WrapPanel>
                                <TextBlock Text="RETENTION AGE (DAYS)" Style="{StaticResource SmartLabCaption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="ArchiveAgeText" Width="95" Text="60"/>
                                <Button Content="CHECK ARCHIVE STATE" Style="{StaticResource SmartLabPrimaryButton}" Click="LoadArchive_Click"/>
                                <Button Content="EXPORT ELIGIBLE USAGE" Click="ExportArchiveUsage_Click"/>
                            </WrapPanel>
                        </Border>
                        <Border Style="{StaticResource SmartLabSectionBorder}">
                            <StackPanel>
                                <TextBlock x:Name="ArchiveSummaryText" Text="Archive plan not loaded." FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ArchiveDetailText" Style="{StaticResource SmartLabCaption}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="EXPORTS">
                    <WrapPanel Margin="14">
                        <Button Content="USAGE CSV" Click="ExportUsage_Click"/>
                        <Button Content="MAINTENANCE CSV" Margin="8,0,0,0" Click="ExportMaintenance_Click"/>
                        <Button Content="INVENTORY CSV" Margin="8,0,0,0" Click="ExportInventory_Click"/>
                        <Button Content="SERVICE DESK CSV" Margin="8,0,0,0" Click="ExportServiceDesk_Click"/>
                        <Button Content="ACTIVITY CSV" Margin="8,0,0,0" Click="ExportActivity_Click"/>
                    </WrapPanel>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>