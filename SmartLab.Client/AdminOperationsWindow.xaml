<Window x:Class="SmartLab.Client.AdminOperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLabSystem — Operations Center"
        Width="1400" Height="860" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartLabPageBackground}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource SmartLabButtonBase}"><Setter Property="MinWidth" Value="90"/><Setter Property="Margin" Value="0,0,7,0"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SmartLabPrimaryButton}"><Setter Property="MinWidth" Value="95"/><Setter Property="Margin" Value="0,0,7,0"/></Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SmartLabDangerButton}"><Setter Property="MinWidth" Value="95"/><Setter Property="Margin" Value="0,0,7,0"/></Style>
        <Style x:Key="FieldBox" TargetType="ComboBox" BasedOn="{StaticResource SmartLabFieldBox}"/>
        <Style x:Key="FieldText" TargetType="TextBox" BasedOn="{StaticResource SmartLabFieldBox}"/>
        <Style x:Key="DarkGrid" TargetType="DataGrid" BasedOn="{StaticResource SmartLabDataGrid}">
            <Setter Property="AutoGenerateColumns" Value="True"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource SmartLabToolbarBorder}" BorderThickness="0,0,0,1" Padding="14,11">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Operations Center" Style="{StaticResource SmartLabPageTitle}" FontSize="18"/>
                    <TextBlock Text="Database-backed administration, maintenance, inventory, assistance, and logs." Style="{StaticResource SmartLabCaption}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Style="{StaticResource SmartLabCaption}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="REFRESH ALL" Style="{StaticResource PrimaryButton}" Click="RefreshAll_Click"/>
                    <Button Content="CLOSE" Style="{StaticResource ActionButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="OperationsTabs" Margin="12" Background="Transparent" BorderThickness="0">
            <TabItem Header="OVERVIEW">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SmartLabSectionBorder}" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="SESSIONS" Style="{StaticResource SmartLabCaption}"/><TextBlock x:Name="TotalSessionsText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource SmartLabSectionBorder}" Padding="12" Margin="8,0"><StackPanel><TextBlock Text="AVG SESSION" Style="{StaticResource SmartLabCaption}"/><TextBlock x:Name="AvgSessionText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource SmartLabSectionBorder}" Padding="12" Margin="8,0"><StackPanel><TextBlock Text="UTILIZATION" Style="{StaticResource SmartLabCaption}"/><TextBlock x:Name="UtilizationText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Grid.Column="3" Style="{StaticResource SmartLabSectionBorder}" Padding="12" Margin="8,0"><StackPanel><TextBlock Text="OFFLINE EVENTS" Style="{StaticResource SmartLabCaption}"/><TextBlock x:Name="OfflineEventsText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Grid.Column="4" Style="{StaticResource SmartLabSectionBorder}" Padding="12" Margin="8,0,0,0"><StackPanel><TextBlock Text="MAINTENANCE EVENTS" Style="{StaticResource SmartLabCaption}"/><TextBlock x:Name="MaintenanceEventsText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SmartLabSectionBorder}" Margin="0,0,6,0"><StackPanel><TextBlock Text="MOST USED" Style="{StaticResource SmartLabSectionTitle}"/><TextBlock x:Name="MostUsedPcText" Text="PC —" FontSize="15" Margin="0,10,0,2"/><TextBlock x:Name="MostUsedLabText" Text="Laboratory —" FontSize="15"/><TextBlock x:Name="PeakHourText" Text="Peak hour —" Style="{StaticResource SmartLabCaption}" Margin="0,7,0,0"/></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource SmartLabSectionBorder}" Margin="6,0,0,0"><StackPanel><TextBlock Text="SYSTEM HEALTH" Style="{StaticResource SmartLabSectionTitle}"/><UniformGrid Columns="4" Margin="0,12,0,12"><StackPanel><TextBlock Text="Available" Style="{StaticResource SmartLabCaption}"/><TextBlock x:Name="HealthAvailableText" Text="—" FontSize="17"/></StackPanel><StackPanel><TextBlock Text="Occupied" Style="{StaticResource SmartLabCaption}"/><TextBlock x:Name="HealthOccupiedText" Text="—" FontSize="17"/></StackPanel><StackPanel><TextBlock Text="Offline" Style="{StaticResource SmartLabCaption}"/><TextBlock x:Name="HealthOfflineText" Text="—" FontSize="17"/></StackPanel><StackPanel><TextBlock Text="Maintenance" Style="{StaticResource SmartLabCaption}"/><TextBlock x:Name="HealthMaintenanceText" Text="—" FontSize="17"/></StackPanel></UniformGrid><TextBlock x:Name="SystemHealthText" Text="Checking..." FontWeight="SemiBold"/><TextBlock x:Name="SystemHealthDetailText" Style="{StaticResource SmartLabCaption}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="SESSIONS">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <WrapPanel>
                            <DatePicker x:Name="UsageFrom" Margin="0,0,8,0"/>
                            <DatePicker x:Name="UsageTo" Margin="0,0,8,0"/>
                            <ComboBox x:Name="UsageLabCombo" Width="170" Style="{StaticResource FieldBox}"/>
                            <ComboBox x:Name="UsagePcCombo" Width="145" Style="{StaticResource FieldBox}"/>
                            <ComboBox x:Name="UsageUserCombo" Width="170" Style="{StaticResource FieldBox}"/>
                            <Button Content="APPLY FILTERS" Style="{StaticResource PrimaryButton}" Click="LoadUsage_Click"/>
                            <Button Content="EXPORT CSV" Style="{StaticResource ActionButton}" Click="ExportUsage_Click"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="UsageGrid" Style="{StaticResource DarkGrid}"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="MAINTENANCE">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <WrapPanel>
                            <ComboBox x:Name="MaintenancePcCombo" Width="180" Style="{StaticResource FieldBox}"/>
                            <TextBox x:Name="MaintenanceReasonText" Width="280" Style="{StaticResource FieldText}" Text="Maintenance required"/>
                            <Button Content="START" Style="{StaticResource PrimaryButton}" Click="StartMaintenance_Click"/>
                            <Button Content="CLEAR" Style="{StaticResource ActionButton}" Click="ClearMaintenance_Click"/>
                            <Button Content="REFRESH" Style="{StaticResource ActionButton}" Click="LoadMaintenance_Click"/>
                            <Button Content="EXPORT CSV" Style="{StaticResource ActionButton}" Click="ExportMaintenance_Click"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="MaintenanceGrid" Style="{StaticResource DarkGrid}"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="INVENTORY">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="REFRESH INVENTORY" Style="{StaticResource ActionButton}" Click="LoadInventory_Click"/>
                        <Button Content="EXPORT CSV" Style="{StaticResource ActionButton}" Click="ExportInventory_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="InventoryGrid" Style="{StaticResource DarkGrid}"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="ASSISTANCE">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <WrapPanel><ComboBox x:Name="AssistanceLabCombo" Width="180" Style="{StaticResource FieldBox}"/><ComboBox x:Name="AssistanceStatusCombo" Width="150" Style="{StaticResource FieldBox}"/><Button Content="LOAD QUEUE" Style="{StaticResource PrimaryButton}" Click="LoadAssistance_Click"/></WrapPanel>
                        <WrapPanel Margin="0,8,0,0"><Button Content="ACKNOWLEDGE" Style="{StaticResource ActionButton}" Click="AcknowledgeAssistance_Click"/><Button Content="IN PROGRESS" Style="{StaticResource ActionButton}" Click="StartAssistance_Click"/><Button Content="RESOLVE" Style="{StaticResource ActionButton}" Click="ResolveAssistance_Click"/><Button Content="CLOSE" Style="{StaticResource ActionButton}" Click="CloseAssistance_Click"/></WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="AssistanceGrid" Style="{StaticResource DarkGrid}"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="ANNOUNCEMENTS">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource SmartLabSectionBorder}" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <TextBlock Text="TITLE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}" VerticalAlignment="Center"/><TextBox x:Name="AnnouncementTitleText" Grid.Column="1" Style="{StaticResource FieldText}"/>
                            <TextBlock Grid.Column="2" Text="TARGET" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}" VerticalAlignment="Center"/><ComboBox x:Name="AnnouncementRoleCombo" Grid.Column="3" Style="{StaticResource FieldBox}"/>
                            <TextBlock Grid.Row="1" Text="MESSAGE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}" VerticalAlignment="Top" Margin="0,8,0,0"/><TextBox x:Name="AnnouncementMessageText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="70" Style="{StaticResource FieldText}" AcceptsReturn="True" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Text="EXPIRES" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}" VerticalAlignment="Center"/><DatePicker x:Name="AnnouncementExpiry" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="CREATE" Style="{StaticResource PrimaryButton}" Click="CreateAnnouncement_Click"/><Button Content="DEACTIVATE" Style="{StaticResource DangerButton}" Click="DeactivateAnnouncement_Click"/><Button Content="REFRESH" Style="{StaticResource ActionButton}" Click="LoadAnnouncements_Click"/></StackPanel>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="AnnouncementGrid" Grid.Row="1" Style="{StaticResource DarkGrid}"/>
                </Grid>
            </TabItem>

            <TabItem Header="SYSTEM LOGS">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="REFRESH" Style="{StaticResource ActionButton}" Click="RefreshAll_Click"/>
                        <Button Content="EXPORT CSV" Style="{StaticResource ActionButton}" Click="ExportActivity_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="ActivityLogGrid" Style="{StaticResource DarkGrid}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIME" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="150"/>
                            <DataGridTextColumn Header="USER" Binding="{Binding Username}" Width="130"/>
                            <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="90"/>
                            <DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="150"/>
                            <DataGridTextColumn Header="PC" Binding="{Binding PcNumber}" Width="90"/>
                            <DataGridTextColumn Header="DETAILS" Binding="{Binding Details}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="ARCHIVE">
                <StackPanel Margin="14">
                    <WrapPanel Margin="0,0,0,12"><TextBlock Text="RETENTION AGE (DAYS)" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="ArchiveAgeText" Width="100" Text="60" Style="{StaticResource FieldText}"/><Button Content="CHECK STATE" Style="{StaticResource PrimaryButton}" Click="LoadArchive_Click"/><Button Content="EXPORT USAGE" Style="{StaticResource ActionButton}" Click="ExportArchiveUsage_Click"/></WrapPanel>
                    <Border Style="{StaticResource SmartLabSectionBorder}" Padding="16"><StackPanel><TextBlock x:Name="ArchiveSummaryText" Text="Archive plan not loaded." FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="ArchiveDetailText" Style="{StaticResource SmartLabCaption}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="EXPORTS">
                <WrapPanel Margin="14"><Button Content="USAGE CSV" Style="{StaticResource ActionButton}" Click="ExportUsage_Click"/><Button Content="MAINTENANCE CSV" Style="{StaticResource ActionButton}" Click="ExportMaintenance_Click"/><Button Content="INVENTORY CSV" Style="{StaticResource ActionButton}" Click="ExportInventory_Click"/><Button Content="SERVICE DESK CSV" Style="{StaticResource ActionButton}" Click="ExportServiceDesk_Click"/><Button Content="ACTIVITY CSV" Style="{StaticResource ActionButton}" Click="ExportActivity_Click"/></WrapPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>