<Window x:Class="SmartLab.Client.AdminOperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Operations Center"
        Width="1450"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Panel2" Color="#F7F9FB"/>
        <SolidColorBrush x:Key="Border" Color="#D7DEE6"/>
        <SolidColorBrush x:Key="Text" Color="#1F2933"/>
        <SolidColorBrush x:Key="Muted" Color="#667583"/>
        <SolidColorBrush x:Key="Blue" Color="#2467A9"/>
        <SolidColorBrush x:Key="Green" Color="#2C7A52"/>
        <SolidColorBrush x:Key="Orange" Color="#9A6A13"/>
        <SolidColorBrush x:Key="Red" Color="#B43D3D"/>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource SmartLabButtonBase}">
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorder}"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="MinWidth" Value="95"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SmartLabPrimaryButton}">
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="MinWidth" Value="95"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SmartLabDangerButton}">
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="MinWidth" Value="95"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Height" Value="34"/>
        </Style>
        <Style x:Key="FieldText" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Height" Value="34"/>
        </Style>
        <Style x:Key="DarkGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorder}"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F7F9FB"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E7EC"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E2E7EC"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SmartLabSurface}" BorderBrush="{StaticResource SmartLabBorder}" BorderThickness="0,0,0,1" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="OPERATIONS CENTER" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Real database-backed Admin/MIS tools" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="REFRESH ALL" Style="{StaticResource PrimaryButton}" Click="RefreshAll_Click"/>
                    <Button Content="CLOSE" Style="{StaticResource ActionButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="OperationsTabs" Background="Transparent" BorderThickness="0" Margin="12">
            <TabItem Header="OVERVIEW">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <UniformGrid Columns="5" Margin="0,0,0,12">
                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="SESSIONS" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="TotalSessionsText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="AVG SESSION" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="AvgSessionText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="UTILIZATION" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="UtilizationText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="OFFLINE EVENTS" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="OfflineEventsText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14">
                                <StackPanel><TextBlock Text="MAINTENANCE EVENTS" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="MaintenanceEventsText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="16" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="MOST USED" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MostUsedPcText" Text="PC —" FontSize="16" Margin="0,12,0,2"/>
                                    <TextBlock x:Name="MostUsedLabText" Text="Laboratory —" FontSize="16"/>
                                    <TextBlock x:Name="PeakHourText" Text="Peak hour —" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="16" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="CURRENT PC HEALTH" FontSize="12" FontWeight="SemiBold"/>
                                    <UniformGrid Columns="4" Margin="0,12,0,0">
                                        <StackPanel><TextBlock Text="Available" Foreground="{StaticResource Muted}"/><TextBlock x:Name="HealthAvailableText" Text="—" FontSize="18"/></StackPanel>
                                        <StackPanel><TextBlock Text="Occupied" Foreground="{StaticResource Muted}"/><TextBlock x:Name="HealthOccupiedText" Text="—" FontSize="18"/></StackPanel>
                                        <StackPanel><TextBlock Text="Offline" Foreground="{StaticResource Muted}"/><TextBlock x:Name="HealthOfflineText" Text="—" FontSize="18"/></StackPanel>
                                        <StackPanel><TextBlock Text="Maintenance" Foreground="{StaticResource Muted}"/><TextBlock x:Name="HealthMaintenanceText" Text="—" FontSize="18"/></StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <GroupBox Header="SYSTEM HEALTH" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}">
                            <StackPanel Margin="12">
                                <TextBlock x:Name="SystemHealthText" Text="Checking server and SQL Server…" FontSize="14"/>
                                <TextBlock x:Name="SystemHealthDetailText" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="USAGE HISTORY">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <DatePicker x:Name="UsageFrom" Margin="0,0,10,0"/>
                            <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <DatePicker x:Name="UsageTo" Margin="0,0,10,0"/>
                            <ComboBox x:Name="UsageLabCombo" Width="170" Style="{StaticResource FieldBox}"/>
                            <ComboBox x:Name="UsagePcCombo" Width="145" Style="{StaticResource FieldBox}"/>
                            <ComboBox x:Name="UsageUserCombo" Width="170" Style="{StaticResource FieldBox}"/>
                            <Button Content="APPLY FILTERS" Style="{StaticResource PrimaryButton}" Click="LoadUsage_Click"/>
                            <Button Content="EXPORT CSV" Style="{StaticResource ActionButton}" Click="ExportUsage_Click"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="UsageGrid" Style="{StaticResource DarkGrid}"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="MAINTENANCE">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <WrapPanel Margin="0,0,0,8">
                            <ComboBox x:Name="MaintenancePcCombo" Width="180" Style="{StaticResource FieldBox}"/>
                            <TextBox x:Name="MaintenanceReasonText" Width="270" Style="{StaticResource FieldText}" Text="Maintenance required"/>
                            <Button Content="START MAINTENANCE" Style="{StaticResource PrimaryButton}" Click="StartMaintenance_Click"/>
                            <Button Content="CLEAR MAINTENANCE" Style="{StaticResource ActionButton}" Click="ClearMaintenance_Click"/>
                            <Button Content="REFRESH" Style="{StaticResource ActionButton}" Click="LoadMaintenance_Click"/>
                            <Button Content="EXPORT CSV" Style="{StaticResource ActionButton}" Click="ExportMaintenance_Click"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="MaintenanceGrid" Style="{StaticResource DarkGrid}"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="HARDWARE INVENTORY">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="REFRESH INVENTORY" Style="{StaticResource ActionButton}" Click="LoadInventory_Click"/>
                        <Button Content="EXPORT CSV" Style="{StaticResource ActionButton}" Click="ExportInventory_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="InventoryGrid" Style="{StaticResource DarkGrid}"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="ASSISTANCE QUEUE">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <WrapPanel Margin="0,0,0,8">
                            <ComboBox x:Name="AssistanceLabCombo" Width="180" Style="{StaticResource FieldBox}"/>
                            <ComboBox x:Name="AssistanceStatusCombo" Width="150" Style="{StaticResource FieldBox}"/>
                            <Button Content="LOAD QUEUE" Style="{StaticResource PrimaryButton}" Click="LoadAssistance_Click"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="ACKNOWLEDGE" Style="{StaticResource ActionButton}" Click="AcknowledgeAssistance_Click"/>
                            <Button Content="IN PROGRESS" Style="{StaticResource ActionButton}" Click="StartAssistance_Click"/>
                            <Button Content="RESOLVE" Style="{StaticResource ActionButton}" Click="ResolveAssistance_Click"/>
                            <Button Content="CLOSE" Style="{StaticResource ActionButton}" Click="CloseAssistance_Click"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="AssistanceGrid" Style="{StaticResource DarkGrid}" SelectionMode="Single"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="ANNOUNCEMENTS">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Title" VerticalAlignment="Center"/><TextBox x:Name="AnnouncementTitleText" Grid.Column="1" Style="{StaticResource FieldText}"/>
                            <TextBlock Text="Target role" Grid.Column="2" VerticalAlignment="Center"/><ComboBox x:Name="AnnouncementRoleCombo" Grid.Column="3" Style="{StaticResource FieldBox}"/>
                            <TextBlock Text="Expires" Grid.Row="1" VerticalAlignment="Center"/><DatePicker x:Name="AnnouncementExpiry" Grid.Row="1" Grid.Column="1"/>
                            <TextBlock Text="Message" Grid.Row="2" VerticalAlignment="Top" Margin="0,8,0,0"/><TextBox x:Name="AnnouncementMessageText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource FieldText}" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="CREATE" Style="{StaticResource PrimaryButton}" Click="CreateAnnouncement_Click"/>
                                <Button Content="DEACTIVATE SELECTED" Style="{StaticResource DangerButton}" Click="DeactivateAnnouncement_Click"/>
                                <Button Content="REFRESH" Style="{StaticResource ActionButton}" Click="LoadAnnouncements_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1" x:Name="AnnouncementGrid" Style="{StaticResource DarkGrid}" SelectionMode="Single"/>
                </Grid>
            </TabItem>

            <TabItem Header="ARCHIVE">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Retention age (days)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="ArchiveAgeText" Width="100" Text="60" Style="{StaticResource FieldText}"/>
                            <Button Content="CHECK ARCHIVE STATE" Style="{StaticResource PrimaryButton}" Click="LoadArchive_Click"/>
                            <Button Content="EXPORT ELIGIBLE USAGE" Style="{StaticResource ActionButton}" Click="ExportArchiveUsage_Click"/>
                        </StackPanel>
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="16">
                            <StackPanel>
                                <TextBlock x:Name="ArchiveSummaryText" Text="Archive plan not loaded." FontSize="16"/>
                                <TextBlock x:Name="ArchiveDetailText" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="EXPORTS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel Margin="14">
                        <Button Content="USAGE CSV" Style="{StaticResource ActionButton}" Click="ExportUsage_Click"/>
                        <Button Content="MAINTENANCE CSV" Style="{StaticResource ActionButton}" Click="ExportMaintenance_Click"/>
                        <Button Content="INVENTORY CSV" Style="{StaticResource ActionButton}" Click="ExportInventory_Click"/>
                        <Button Content="SERVICE DESK CSV" Style="{StaticResource ActionButton}" Click="ExportServiceDesk_Click"/>
                        <Button Content="ACTIVITY CSV" Style="{StaticResource ActionButton}" Click="ExportActivity_Click"/>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
