<Window x:Class="SmartLab.Client.TeacherDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Teacher Dashboard"
        Width="1320" Height="820" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SmartLabToolbarBorder}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TEACHER OPERATIONS" Style="{StaticResource SmartLabPageTitle}" FontSize="20"/>
                    <TextBlock x:Name="TeacherNameText" Text="Teacher" Style="{StaticResource SmartLabCaption}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="122" Height="34" Margin="0,0,8,0">
                        <Button x:Name="NotificationButton" Content="NOTIFICATIONS" Height="34"
                                Style="{StaticResource SmartLabButtonBase}" Click="NotificationButton_Click"/>
                        <Border x:Name="NotificationCountBadge" Width="19" Height="19"
                                CornerRadius="9" Background="{StaticResource SmartLabDanger}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="NotificationCountText" Text="0" FontSize="10"
                                       FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <Button Content="REFRESH" Width="92" Margin="0,0,8,0"
                            Style="{StaticResource SmartLabPrimaryButton}" Click="RefreshButton_Click"/>
                    <Button Content="LOGOUT" Width="88"
                            Style="{StaticResource SmartLabDangerButton}" Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SmartLabSectionBorder}" Margin="0,0,8,0" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="CURRENT PC STATUS" Style="{StaticResource SmartLabCaption}"/>
                        <TextBlock Grid.Column="1" x:Name="PcStatusSummaryText" Text="Loading…" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="LIVE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource SmartLabSuccess}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Button Grid.Column="1" Content="VIEW PC SCREEN"
                    Style="{StaticResource SmartLabButtonBase}" Margin="4,0,8,0"
                    Click="ViewPcScreenButton_Click"/>
            <Button Grid.Column="2" Content="NEED ASSISTANCE"
                    Style="{StaticResource SmartLabPrimaryButton}" Margin="4,0,0,0"
                    Click="NeedAssistanceButton_Click"/>
        </Grid>

        <Border x:Name="NotificationBanner" Grid.Row="2" Visibility="Collapsed"
                Background="{StaticResource SmartLabAccentSoft}"
                BorderBrush="{StaticResource SmartLabBorder}"
                BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="NotificationTitleText" Text="SMARTLAB NOTIFICATION"
                               FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="NotificationMessageText" Text="Notification message"
                               Style="{StaticResource SmartLabCaption}" Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="DISMISS" Width="84"
                        Style="{StaticResource SmartLabButtonBase}"
                        Click="DismissNotificationButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,0" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SmartLabSectionBorder}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="LABORATORY COMPUTERS" Style="{StaticResource SmartLabSectionTitle}"/>
                            <TextBlock Text="Live status for computers available to your current operations."
                                       Style="{StaticResource SmartLabCaption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="READ ONLY" Style="{StaticResource SmartLabCaption}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <DataGrid x:Name="PcGrid" Grid.Row="1" Style="{StaticResource SmartLabDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PC" Width="100" Binding="{Binding PcNumber}"/>
                            <DataGridTextColumn Header="STATUS" Width="115" Binding="{Binding Status}"/>
                            <DataGridTextColumn Header="USER" Width="150" Binding="{Binding Username}"/>
                            <DataGridTextColumn Header="LAST SEEN" Width="*" Binding="{Binding LastSeen, StringFormat={}{0:HH:mm:ss}}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="1*"/><RowDefinition Height="1.1*"/></Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SmartLabSectionBorder}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="MIS ANNOUNCEMENTS" Style="{StaticResource SmartLabSectionTitle}"/>
                                <TextBlock Text="Current messages from the MIS team." Style="{StaticResource SmartLabCaption}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid x:Name="AnnouncementGrid" Grid.Row="1" Style="{StaticResource SmartLabDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TITLE" Width="145" Binding="{Binding Title}"/>
                                <DataGridTextColumn Header="MESSAGE" Width="*" Binding="{Binding Message}"/>
                                <DataGridTextColumn Header="DATE" Width="115" Binding="{Binding CreatedAt, StringFormat={}{0:MM/dd HH:mm}}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource SmartLabSectionBorder}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="MY ASSISTANCE HISTORY" Style="{StaticResource SmartLabSectionTitle}"/>
                            <TextBlock Text="Requests you have submitted and their current status."
                                       Style="{StaticResource SmartLabCaption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <DataGrid x:Name="HistoryGrid" Grid.Row="1" Style="{StaticResource SmartLabDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SUBJECT" Width="140" Binding="{Binding Subject}"/>
                                <DataGridTextColumn Header="STATUS" Width="100" Binding="{Binding Status}"/>
                                <DataGridTextColumn Header="CREATED" Width="120" Binding="{Binding CreatedAt, StringFormat={}{0:MM/dd HH:mm}}"/>
                                <DataGridTextColumn Header="RESOLUTION" Width="*" Binding="{Binding ResolutionNotes}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="StatusText" Text="Connected"
                   Style="{StaticResource SmartLabCaption}" Margin="2,10,0,0"/>
    </Grid>
</Window>