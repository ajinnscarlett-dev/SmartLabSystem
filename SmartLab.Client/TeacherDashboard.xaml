<Window x:Class="SmartLab.Client.TeacherDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLabSystem — Teacher"
        Width="1340" Height="820" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SmartLabSurface}" BorderBrush="{StaticResource SmartLabBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Teacher Operations" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Laboratory classroom monitoring and assistance" Style="{StaticResource SmartLabCaption}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TeacherNameText" Text="Teacher" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Grid Width="62" Height="34">
                        <Button x:Name="NotificationButton" Content="ALERTS" Style="{StaticResource SmartLabButtonBase}" Width="62" Height="34" Click="NotificationButton_Click"/>
                        <Border x:Name="NotificationCountBadge" Width="17" Height="17" CornerRadius="8" Background="{StaticResource SmartLabDanger}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                            <TextBlock x:Name="NotificationCountText" Text="0" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <Button Content="REFRESH" Width="82" Height="34" Style="{StaticResource SmartLabButtonBase}" Margin="8,0,0,0" Click="RefreshButton_Click"/>
                    <Button Content="LOGOUT" Width="78" Height="34" Style="{StaticResource SmartLabDangerButton}" Margin="8,0,0,0" Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="220"/></Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,2,0,14">
                    <StackPanel>
                        <TextBlock Text="Teacher Dashboard" Style="{StaticResource SmartLabPageTitle}"/>
                        <TextBlock Text="Focus on the current lab, student workstation state, and assistance requests." Style="{StaticResource SmartLabCaption}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="Connected" Style="{StaticResource SmartLabCaption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SmartLabToolbarBorder}" Padding="12" Margin="0,0,8,0">
                        <Grid><TextBlock Text="CURRENT LABORATORY" Style="{StaticResource SmartLabCaption}"/><TextBlock x:Name="PcStatusSummaryText" Text="Loading..." FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                    </Border>
                    <Button Grid.Column="1" Content="VIEW PC SCREEN" Height="42" Style="{StaticResource SmartLabButtonBase}" Margin="8,0" Click="ViewPcScreenButton_Click"/>
                    <Button Grid.Column="2" Content="NEED ASSISTANCE" Height="42" Style="{StaticResource SmartLabPrimaryButton}" Margin="8,0,0,0" Click="NeedAssistanceButton_Click"/>
                </Grid>

                <Border x:Name="NotificationBanner" Grid.Row="2" Visibility="Collapsed" Background="{StaticResource SmartLabAccentSoft}" BorderBrush="{StaticResource SmartLabBorder}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                    <Grid><StackPanel><TextBlock x:Name="NotificationTitleText" Text="SMARTLAB NOTIFICATION" FontWeight="SemiBold"/><TextBlock x:Name="NotificationMessageText" Text="Notification message" Style="{StaticResource SmartLabCaption}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel><Button Content="DISMISS" Width="84" Height="32" HorizontalAlignment="Right" Click="DismissNotificationButton_Click"/></Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SmartLabSectionBorder}" Padding="12" Margin="0,0,8,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8"><StackPanel><TextBlock Text="STUDENT PC WORKSPACE" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Live workstation state for the current laboratory." Style="{StaticResource SmartLabCaption}" Margin="0,2,0,0"/></StackPanel></Grid>
                            <DataGrid x:Name="PcGrid" Grid.Row="1" Style="{StaticResource SmartLabDataGrid}">
                                <DataGrid.Columns><DataGridTextColumn Header="PC" Binding="{Binding PcNumber}" Width="95"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="115"/><DataGridTextColumn Header="STUDENT" Binding="{Binding Username}" Width="150"/><DataGridTextColumn Header="LAST SEEN" Binding="{Binding LastSeen, StringFormat={}{0:HH:mm:ss}}" Width="*"/></DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource SmartLabSectionBorder}" Padding="12" Margin="0,0,0,6">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="ANNOUNCEMENTS" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DataGrid x:Name="AnnouncementGrid" Grid.Row="1" Style="{StaticResource SmartLabDataGrid}">
                                    <DataGrid.Columns><DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="145"/><DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="*"/><DataGridTextColumn Header="DATE" Binding="{Binding CreatedAt, StringFormat={}{0:MM/dd HH:mm}}" Width="105"/></DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource SmartLabSectionBorder}" Padding="12" Margin="0,6,0,0">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="ASSISTANCE HISTORY" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DataGrid x:Name="HistoryGrid" Grid.Row="1" Style="{StaticResource SmartLabDataGrid}">
                                    <DataGrid.Columns><DataGridTextColumn Header="SUBJECT" Binding="{Binding Subject}" Width="130"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="CREATED" Binding="{Binding CreatedAt, StringFormat={}{0:MM/dd HH:mm}}" Width="110"/><DataGridTextColumn Header="RESOLUTION" Binding="{Binding ResolutionNotes}" Width="*"/></DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource SmartLabToolbarBorder}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="CLASSROOM OPERATIONS" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Use the workstation table for live state and the dedicated assistance flow when a student needs help." Style="{StaticResource SmartLabCaption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>