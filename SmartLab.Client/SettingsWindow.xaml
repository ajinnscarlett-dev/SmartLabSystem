<Window x:Class="SmartLab.Client.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Settings"
        Width="760" Height="560" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SETTINGS" Style="{StaticResource SmartLabPageTitle}"/>
                <TextBlock Text="Operational client and connection information."
                           Style="{StaticResource SmartLabCaption}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="BACK" Style="{StaticResource SmartLabBackButton}" Click="CloseButton_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SmartLabSectionBorder}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="SIGNED-IN ACCOUNT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}"/>
                    <TextBlock x:Name="UserText" Grid.Column="1" Foreground="{StaticResource SmartLabText}"/>
                    <TextBlock Text="PC ASSIGNMENT" Grid.Row="1" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}" Margin="0,10,0,0"/>
                    <TextBlock x:Name="PcText" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource SmartLabText}" Margin="0,10,0,0"/>
                    <TextBlock Text="CLIENT RUNTIME" Grid.Row="2" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}" Margin="0,10,0,0"/>
                    <TextBlock x:Name="RuntimeText" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource SmartLabText}" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource SmartLabSectionBorder}">
                <StackPanel>
                    <TextBlock Text="SERVER CONNECTION" Style="{StaticResource SmartLabSectionTitle}"/>
                    <TextBlock Text="CURRENT API ENDPOINT" Style="{StaticResource SmartLabCaption}" Margin="0,14,0,4"/>
                    <TextBlock x:Name="ServerUrlText" TextWrapping="Wrap" Text="—"/>
                    <TextBlock Text="RESOLUTION STATUS" Style="{StaticResource SmartLabCaption}" Margin="0,14,0,4"/>
                    <TextBlock x:Name="ConnectionStatusText" Text="Not checked"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="REFRESH CONNECTION" Width="160" Style="{StaticResource SmartLabPrimaryButton}"
                                Click="RefreshConnectionButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Style="{StaticResource SmartLabCaption}"/>
        </Grid>
    </Grid>
</Window>