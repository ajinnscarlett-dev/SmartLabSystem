<Window x:Class="SmartLab.Client.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Settings"
        Width="720"
        Height="560"
        MinWidth="620"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}"
        FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="SETTINGS" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Operational client and connection information."
                       FontSize="12" Foreground="{StaticResource SmartLabMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource SmartLabSurface}"
                BorderBrush="{StaticResource SmartLabBorder}"
                BorderThickness="1"
                Padding="14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Signed-in account" FontWeight="SemiBold"/>
                <TextBlock x:Name="UserText" Grid.Column="1" Foreground="{StaticResource SmartLabMuted}"/>
                <TextBlock Text="PC assignment" Grid.Row="1" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBlock x:Name="PcText" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource SmartLabMuted}" Margin="0,10,0,0"/>
                <TextBlock Text="Client runtime" Grid.Row="2" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBlock x:Name="RuntimeText" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource SmartLabMuted}" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource SmartLabSurface}"
                BorderBrush="{StaticResource SmartLabBorder}"
                BorderThickness="1"
                Padding="14">
            <StackPanel>
                <TextBlock Text="SERVER CONNECTION" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource SmartLabMuted}"/>
                <TextBlock Text="Current API endpoint" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <TextBlock x:Name="ServerUrlText" TextWrapping="Wrap" Text="—"/>
                <TextBlock Text="Server resolution status" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <TextBlock x:Name="ConnectionStatusText" Text="Not checked"
                           Foreground="{StaticResource SmartLabMuted}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Content="REFRESH CONNECTION" Width="150" Height="34"
                            Style="{StaticResource SmartLabPrimaryButton}" Click="RefreshConnectionButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center"
                       Foreground="{StaticResource SmartLabMuted}"/>
            <Button Content="CLOSE" Width="90" Height="34"
                    HorizontalAlignment="Right" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
