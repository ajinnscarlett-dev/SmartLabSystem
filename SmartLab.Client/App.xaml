<Application x:Class="SmartLab.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- SmartLabSystem enterprise desktop design system -->
        <SolidColorBrush x:Key="SmartLabPageBackground" Color="#F4F6F8"/>
        <SolidColorBrush x:Key="SmartLabSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SmartLabSurfaceAlt" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SmartLabText" Color="#18212B"/>
        <SolidColorBrush x:Key="SmartLabMuted" Color="#667684"/>
        <SolidColorBrush x:Key="SmartLabBorder" Color="#D7DEE5"/>
        <SolidColorBrush x:Key="SmartLabBorderStrong" Color="#C7D1DA"/>
        <SolidColorBrush x:Key="SmartLabAccent" Color="#2067A5"/>
        <SolidColorBrush x:Key="SmartLabAccentHover" Color="#184F80"/>
        <SolidColorBrush x:Key="SmartLabAccentSoft" Color="#EAF2F9"/>
        <SolidColorBrush x:Key="SmartLabDanger" Color="#B83A3A"/>
        <SolidColorBrush x:Key="SmartLabDisabled" Color="#AAB5BE"/>

        <SolidColorBrush x:Key="SmartLabSuccess" Color="#2D7A57"/>
        <SolidColorBrush x:Key="SmartLabWarning" Color="#9A6A22"/>
        <SolidColorBrush x:Key="SmartLabInfo" Color="#3E719C"/>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="Background" Value="{StaticResource SmartLabPageBackground}"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
        </Style>

        <Style x:Key="SmartLabPageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
        </Style>

        <Style x:Key="SmartLabSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
        </Style>

        <Style x:Key="SmartLabCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabMuted}"/>
        </Style>

        <Style x:Key="SmartLabSectionBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="SmartLabToolbarBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="SmartLabStrongBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SmartLabButtonBase" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SmartLabPrimaryButton" TargetType="Button" BasedOn="{StaticResource SmartLabButtonBase}">
            <Setter Property="Background" Value="{StaticResource SmartLabAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabAccent}"/>
        </Style>

        <Style x:Key="SmartLabDangerButton" TargetType="Button" BasedOn="{StaticResource SmartLabButtonBase}">
            <Setter Property="Background" Value="{StaticResource SmartLabDanger}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabDanger}"/>
        </Style>

        <Style x:Key="SmartLabBackButton" TargetType="Button" BasedOn="{StaticResource SmartLabButtonBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabAccent}"/>
            <Setter Property="Padding" Value="4,5"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <Style x:Key="SmartLabNavButton" TargetType="Button" BasedOn="{StaticResource SmartLabButtonBase}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="SmartLabFieldBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style x:Key="SmartLabFieldText" TargetType="TextBox" BasedOn="{StaticResource SmartLabFieldBox}"/>
        
        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <Style x:Key="SmartLabTabItem" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>

        <Style x:Key="SmartLabDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E6EBEF"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E6EBEF"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <!-- Compatibility keys used by legacy AdminDashboard theme code. -->
        <SolidColorBrush x:Key="Bg" Color="#F4F6F8"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Panel2" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Border" Color="#D7DEE5"/>
        <SolidColorBrush x:Key="Text" Color="#18212B"/>
        <SolidColorBrush x:Key="Muted" Color="#667684"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBorder" Color="#D7DEE5"/>
        <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="GridBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="GridAlt" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="GridArea" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Header" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Red" Color="#B83A3A"/>
        <SolidColorBrush x:Key="Green" Color="#2D7A57"/>
        <SolidColorBrush x:Key="Orange" Color="#9A6A22"/>
        <SolidColorBrush x:Key="Blue" Color="#2067A5"/>
        <SolidColorBrush x:Key="Purple" Color="#5B4A9B"/>
    </Application.Resources>
</Application>