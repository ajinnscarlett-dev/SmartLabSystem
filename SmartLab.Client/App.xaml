<Application x:Class="SmartLab.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="SmartLabAccent" Color="#2F75B5"/>
        <SolidColorBrush x:Key="SmartLabAccentHover" Color="#3B86C6"/>
        <SolidColorBrush x:Key="SmartLabControlBorder" Color="#C7D2DB"/>
        <SolidColorBrush x:Key="SmartLabControlBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SmartLabSurface" Color="#F4F7F9"/>
        <SolidColorBrush x:Key="SmartLabText" Color="#1D2A33"/>
        <SolidColorBrush x:Key="SmartLabMuted" Color="#667783"/>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="Background" Value="{StaticResource SmartLabControlBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource SmartLabControlBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="Background" Value="{StaticResource SmartLabControlBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Application.Resources>
</Application>
