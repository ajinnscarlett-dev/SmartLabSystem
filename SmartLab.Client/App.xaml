<Application x:Class="SmartLab.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="SmartLabPageBackground" Color="#F3F5F8"/>
        <SolidColorBrush x:Key="SmartLabSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SmartLabSurfaceAlt" Color="#F7F9FB"/>
        <SolidColorBrush x:Key="SmartLabBorder" Color="#D7DEE6"/>
        <SolidColorBrush x:Key="SmartLabBorderStrong" Color="#C3CDD7"/>
        <SolidColorBrush x:Key="SmartLabText" Color="#1F2933"/>
        <SolidColorBrush x:Key="SmartLabMuted" Color="#667583"/>
        <SolidColorBrush x:Key="SmartLabAccent" Color="#2467A9"/>
        <SolidColorBrush x:Key="SmartLabAccentHover" Color="#1D568F"/>
        <SolidColorBrush x:Key="SmartLabAccentSoft" Color="#EAF2F9"/>
        <SolidColorBrush x:Key="SmartLabSuccess" Color="#2C7A52"/>
        <SolidColorBrush x:Key="SmartLabWarning" Color="#9A6A13"/>
        <SolidColorBrush x:Key="SmartLabDanger" Color="#B43D3D"/>
        <SolidColorBrush x:Key="SmartLabDangerSoft" Color="#F9EEEE"/>
        <SolidColorBrush x:Key="SmartLabDisabled" Color="#9AA6B2"/>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="SmartLabButtonBase" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SmartLabPrimaryButton" TargetType="Button" BasedOn="{StaticResource SmartLabButtonBase}">
            <Setter Property="Background" Value="{StaticResource SmartLabAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SmartLabDangerButton" TargetType="Button" BasedOn="{StaticResource SmartLabButtonBase}">
            <Setter Property="Background" Value="{StaticResource SmartLabDanger}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabDanger}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SmartLabSectionBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource SmartLabButtonBase}"/>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorder}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SmartLabSurfaceAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>
    </Application.Resources>
</Application>
