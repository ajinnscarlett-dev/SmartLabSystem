<Window x:Class="SmartLab.Client.ScheduleManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Schedule Management"
        Width="1320"
        Height="760"
        MinWidth="1050"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="SCHEDULE MANAGEMENT" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Assign Teachers to laboratories by date and time. Conflicts are rejected by the server."
                           FontSize="12" Foreground="{StaticResource SmartLabMuted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="CLOSE" Width="90" Height="34" HorizontalAlignment="Right" Click="CloseButton_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DatePicker x:Name="ScheduleDatePicker" Grid.Column="0" Height="36"/>
            <Button Grid.Column="1" Content="ADD SCHEDULE" Width="130" Height="36" Margin="8,0,0,0"
                    Style="{StaticResource SmartLabPrimaryButton}" Click="AddButton_Click"/>
            <Button Grid.Column="2" Content="REFRESH" Width="90" Height="36" Margin="8,0,0,0"
                    Click="RefreshButton_Click"/>
            <TextBlock x:Name="StatusText" Grid.Column="3" Text="Ready" Margin="12,0,0,0"
                       VerticalAlignment="Center" Foreground="{StaticResource SmartLabMuted}"/>
        </Grid>

        <DataGrid x:Name="ScheduleGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  Background="{StaticResource SmartLabSurface}"
                  Foreground="{StaticResource SmartLabText}"
                  BorderBrush="{StaticResource SmartLabBorder}"
                  RowBackground="{StaticResource SmartLabSurface}"
                  AlternatingRowBackground="{StaticResource SmartLabSurfaceAlt}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E2E7EC"
                  RowHeight="36">
            <DataGrid.Columns>
                <DataGridTextColumn Header="TIME" Binding="{Binding TimeText}" Width="120"/>
                <DataGridTextColumn Header="LABORATORY" Binding="{Binding LaboratoryName}" Width="150"/>
                <DataGridTextColumn Header="SUBJECT" Binding="{Binding SubjectName}" Width="220"/>
                <DataGridTextColumn Header="CLASS" Binding="{Binding ClassName}" Width="180"/>
                <DataGridTextColumn Header="TEACHER" Binding="{Binding TeacherName}" Width="210"/>
                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/>
                <DataGridTemplateColumn Header="ACTIONS" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="EDIT" Width="60" Height="30" Margin="2"
                                        Tag="{Binding}" Click="EditButton_Click"/>
                                <Button Content="DELETE" Width="72" Height="30" Margin="2"
                                        Style="{StaticResource SmartLabDangerButton}"
                                        Tag="{Binding}" Click="DeleteButton_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3"
                   Text="Teacher access to a laboratory is determined by the active schedule."
                   FontSize="11"
                   Foreground="{StaticResource SmartLabMuted}"
                   Margin="0,12,0,0"/>
    </Grid>
</Window>
