<Window x:Class="SmartLab.Client.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Lab Management System"
        Width="1550"
        Height="900"
        MinWidth="1250"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- PRACTICAL ADMIN UI PALETTE -->
        <!-- ===================================================== -->

        <SolidColorBrush x:Key="Bg" Color="#081018"/>
        <SolidColorBrush x:Key="Panel" Color="#0D171F"/>
        <SolidColorBrush x:Key="Panel2" Color="#111D26"/>
        <SolidColorBrush x:Key="Border" Color="#23333E"/>
        <SolidColorBrush x:Key="Text" Color="#E9EEF2"/>
        <SolidColorBrush x:Key="Muted" Color="#8B9AA5"/>
        <SolidColorBrush x:Key="Blue" Color="#4C91E8"/>
        <SolidColorBrush x:Key="Green" Color="#3ABF78"/>
        <SolidColorBrush x:Key="Orange" Color="#D98A2B"/>
        <SolidColorBrush x:Key="Red" Color="#C95353"/>
        <SolidColorBrush x:Key="Purple" Color="#795FC8"/>
        <SolidColorBrush x:Key="Header" Color="#0B141B"/>
        <SolidColorBrush x:Key="GridArea" Color="#0A141B"/>
        <SolidColorBrush x:Key="ControlBg" Color="#101C24"/>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B6C2C9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#14232D"/>
            <Setter Property="Foreground" Value="#E8EDF0"/>
            <Setter Property="BorderBrush" Value="#2A3A45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#215D9F"/>
            <Setter Property="BorderBrush" Value="#3C81C9"/>
        </Style>

        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#185D3A"/>
            <Setter Property="BorderBrush" Value="#2F8B61"/>
        </Style>

        <Style x:Key="PurpleButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#4B3A80"/>
            <Setter Property="BorderBrush" Value="#6C5AA7"/>
        </Style>

        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#5E2A2A"/>
            <Setter Property="BorderBrush" Value="#8A4141"/>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="#2A3A45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="#2A3A45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style x:Key="AdminTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style x:Key="DarkDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource GridArea}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="RowBackground" Value="#0C171E"/>
            <Setter Property="AlternatingRowBackground" Value="#101C24"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#24333D"/>
            <Setter Property="VerticalGridLinesBrush" Value="#24333D"/>
            <Setter Property="RowHeight" Value="34"/>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource Bg}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="RightSidebarColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- ===================================================== -->
        <!-- LEFT NAVIGATION -->
        <!-- ===================================================== -->

        <Border Grid.Column="0"
                Background="#091219"
                BorderBrush="#1D2A33"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="68"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,16,8,0">
                    <TextBlock Text="Smart Lab Manager"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text}"/>
                    <TextBlock Text="Admin Dashboard"
                               Margin="0,3,0,0"
                               FontSize="10"
                               Foreground="{StaticResource Muted}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,8,12,12">

                        <TextBlock Text="MAIN"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#65737D"
                                   Margin="8,8,0,6"/>

                        <Button Style="{StaticResource NavButton}"
                                Background="#143B66"
                                Foreground="{StaticResource Text}"
                                Click="DashboardNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌂" Width="26" FontSize="15"/>
                                <TextBlock Text="Dashboard"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="UserManagementNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="♙" Width="26" FontSize="14"/>
                                <TextBlock Text="Users"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="LaboratoriesNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▤" Width="26" FontSize="14"/>
                                <TextBlock Text="Laboratories"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="PcManagementNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="26" FontSize="14"/>
                                <TextBlock Text="Computers"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="ReportsNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◷" Width="26" FontSize="14"/>
                                <TextBlock Text="Schedules"/>
                            </StackPanel>
                        </Button>

                        
                        <Button Style="{StaticResource NavButton}"
                                Click="ServiceDeskNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="!" Width="26" FontSize="14"/>
                                <TextBlock Text="Incidents"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="PcManagementNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚒" Width="26" FontSize="14"/>
                                <TextBlock Text="Maintenance"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="ReportsNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▥" Width="26" FontSize="14"/>
                                <TextBlock Text="Reports"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="AnnouncementsNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◈" Width="26" FontSize="14"/>
                                <TextBlock Text="Announcements"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="SettingsNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Width="26" FontSize="14"/>
                                <TextBlock Text="Settings"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1"
                                Background="#1B2A34"
                                Margin="7,12"/>

                        <TextBlock Text="LABORATORIES"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#65737D"
                                   Margin="8,3,0,6"/>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="26" FontSize="14"/>
                                <TextBlock Text="ComLab 101"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Background="#143B66"
                                Foreground="{StaticResource Text}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="26" FontSize="14"/>
                                <TextBlock Text="ComLab 601"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="26" FontSize="14"/>
                                <TextBlock Text="ComLab 602"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="26" FontSize="14"/>
                                <TextBlock Text="ComLab 603"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="26" FontSize="14"/>
                                <TextBlock Text="ComLab 604"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="26" FontSize="14"/>
                                <TextBlock Text="ComLab 605"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="26" FontSize="14"/>
                                <TextBlock Text="ComLab 607"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="26" FontSize="14"/>
                                <TextBlock Text="ComLab 609"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="2"
                        Style="{StaticResource PurpleButton}"
                        Margin="14,10"
                        Height="40"
                        Content="SEND ANNOUNCEMENT"
                        Click="AnnouncementsNavButton_Click"/>
            </Grid>
        </Border>

        <!-- ===================================================== -->
        <!-- MAIN WORKSPACE -->
        <!-- ===================================================== -->

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="{StaticResource Header}"
                    BorderBrush="#1C2B34"
                    BorderThickness="0,0,0,1">

                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              Width="220"
                              Style="{StaticResource DarkCombo}"
                              VerticalAlignment="Center"
                              SelectedIndex="1"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Background="#111F28"
                                BorderBrush="#263843"
                                BorderThickness="1"
                                Padding="13,7"
                                Margin="0,0,8,0">
                            <TextBlock Text="LIVE MONITORING"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#A9B7BF"/>
                        </Border>

                        <Button Content="REFRESH"
                                Style="{StaticResource BlueButton}"
                                Width="86"
                                Height="32"
                                Click="RefreshButton_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button x:Name="ThemeToggleButton"
                                Width="44"
                                Height="34"
                                Margin="0,0,7,0"
                                Style="{StaticResource ActionButton}"
                                Content="☾"
                                Click="HeaderThemeButton_Click"/>

                        <Grid Width="44"
                              Height="34"
                              Margin="0,0,7,0">
                            <Button x:Name="NotificationButton"
                                    Width="44"
                                    Height="34"
                                    Style="{StaticResource ActionButton}"
                                    Content="🔔"
                                    Click="HeaderBellButton_Click"/>

                            <Border x:Name="NotificationBadge"
                                    Width="17"
                                    Height="17"
                                    CornerRadius="8"
                                    Background="{StaticResource Red}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="NotificationCountText"
                                           Text="0"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Button Width="104"
                                Height="34"
                                Style="{StaticResource ActionButton}"
                                Content="Admin  ▾"
                                Click="ProfileButton_Click"/>

                        <Button Width="80"
                                Height="34"
                                Margin="7,0,0,0"
                                Style="{StaticResource RedButton}"
                                Content="LOGOUT"
                                Click="LogoutButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <ScrollViewer x:Name="MainScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid Margin="12,12,12,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- MONITORING HEADER -->
                    <Grid Grid.Row="0" Margin="2,0,2,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="COMLAB 601"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}"/>
                            <TextBlock Text="  •  "
                                       Foreground="#566671"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="ApiStatusText"
                                       Text="Connecting..."
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="SHOW:"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="9"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center"/>
                            <Button Content="GRID"
                                    Style="{StaticResource ActionButton}"
                                    Width="58"
                                    Height="26"
                                    FontSize="9"
                                    Margin="0,0,4,0"
                                    Click="GridViewButton_Click"/>
                            <Button Content="LIST"
                                    Style="{StaticResource ActionButton}"
                                    Width="58"
                                    Height="26"
                                    FontSize="9"
                                    Click="ListViewButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- MAIN MONITORING GRID -->
                    <Border Grid.Row="1"
                            Background="{StaticResource GridArea}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            Padding="12">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="25"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="LIVE SCREENS"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#C5D0D7"/>
                                    <TextBlock Text="  |  Click a PC to inspect"
                                               FontSize="9"
                                               Foreground="{StaticResource Muted}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="● Online"
                                               Foreground="{StaticResource Green}"
                                               FontSize="9"
                                               Margin="0,0,12,0"/>
                                    <TextBlock Text="● In Use"
                                               Foreground="{StaticResource Blue}"
                                               FontSize="9"
                                               Margin="0,0,12,0"/>
                                    <TextBlock Text="● Maintenance"
                                               Foreground="{StaticResource Orange}"
                                               FontSize="9"
                                               Margin="0,0,12,0"/>
                                    <TextBlock Text="● Offline"
                                               Foreground="#9DA8AF"
                                               FontSize="9"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">

                                <UniformGrid x:Name="PcGrid"
                                             Columns="4"
                                             Margin="0,2,0,6"/>
                            </ScrollViewer>

                            <Border Grid.Row="2"
                                    Background="#0B171E"
                                    BorderBrush="#20313A"
                                    BorderThickness="1,0,0,0"
                                    Padding="6,4">
                                <TextBlock Text="Live monitoring updates automatically."
                                           Foreground="#74848E"
                                           FontSize="9"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- SUMMARY STRIP -->
                    <Grid Grid.Row="2"
                          Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                Padding="10"
                                Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="LABS"
                                           FontSize="9"
                                           Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="8"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Text}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                Padding="10"
                                Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="COMPUTERS"
                                           FontSize="9"
                                           Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="TotalPcText"
                                           Text="0"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Text}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                Padding="10"
                                Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="ONLINE"
                                           FontSize="9"
                                           Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="AvailablePcText"
                                           Text="0"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Green}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3"
                                Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                Padding="10"
                                Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="IN USE"
                                           FontSize="9"
                                           Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="OccupiedPcText"
                                           Text="0"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Blue}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4"
                                Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                Padding="10"
                                Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="MAINT."
                                           FontSize="9"
                                           Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="MaintenancePcText"
                                           Text="0"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Orange}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="5"
                                Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                Padding="10"
                                Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="OFFLINE"
                                           FontSize="9"
                                           Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="OfflinePcText"
                                           Text="0"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#9EA8AE"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ===================================================== -->
        <!-- RIGHT SELECTED PC PANEL -->
        <!-- ===================================================== -->

        <Border x:Name="SelectedPcSidebar"
                Grid.Column="2"
                Background="#09131A"
                BorderBrush="#22343E"
                BorderThickness="1,0,0,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">

                    <Grid Margin="0,2,0,10">
                        <StackPanel>
                            <TextBlock Text="SELECTED PC"
                                       FontSize="9"
                                       Foreground="#71808A"/>
                            <TextBlock x:Name="AdminNameText"
                                       Text="Admin"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}"/>
                        </StackPanel>

                        <Button Content="×"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                Style="{StaticResource ActionButton}"
                                Click="ClearSelectedPcButton_Click"/>
                    </Grid>

                    <Border Background="{StaticResource Panel}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            Padding="10">

                        <StackPanel>

                            <TextBlock x:Name="SelectedPcTitleText"
                                       Text="Select a PC"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}"/>

                            <TextBlock x:Name="SelectedPcHintText"
                                       Text="No current user"
                                       FontSize="9"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,3,0,8"/>

                            <Border Height="110"
                                    Background="#0A151C"
                                    BorderBrush="#233640"
                                    BorderThickness="1">
                                <TextBlock Text="▣"
                                           FontSize="38"
                                           Foreground="#4A8BC9"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Current User"
                                       FontSize="9"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,10,0,0"/>
                            <TextBlock x:Name="SelectedPcCurrentUserText"
                                       Text="—"
                                       FontSize="11"
                                       Foreground="{StaticResource Text}"/>

                            <TextBlock Text="Login Time"
                                       FontSize="9"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,8,0,0"/>
                            <TextBlock x:Name="SelectedPcLoginTimeText"
                                       Text="—"
                                       FontSize="11"
                                       Foreground="{StaticResource Text}"/>

                            <TextBlock Text="IP Address"
                                       FontSize="9"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,8,0,0"/>
                            <TextBlock x:Name="SelectedPcIpText"
                                       Text="—"
                                       FontSize="11"
                                       Foreground="{StaticResource Text}"/>

                            <TextBlock Text="Laboratory"
                                       FontSize="9"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,8,0,0"/>
                            <TextBlock x:Name="SelectedPcLabText"
                                       Text="—"
                                       FontSize="11"
                                       Foreground="{StaticResource Text}"/>

                            <TextBlock Text="Status"
                                       FontSize="9"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,8,0,0"/>
                            <TextBlock x:Name="SelectedPcStatusText"
                                       Text="● Offline"
                                       FontSize="11"
                                       Foreground="{StaticResource Green}"/>

                            <TextBlock Text="Last Seen"
                                       FontSize="9"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,8,0,0"/>
                            <TextBlock x:Name="SelectedPcLastSeenText"
                                       Text="—"
                                       FontSize="11"
                                       Foreground="{StaticResource Text}"/>

                            <TextBlock Text="QUICK ACTIONS"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}"
                                       Margin="0,14,0,8"/>

                            <Button x:Name="ViewFullScreenButton"
                                    Content="VIEW FULL SCREEN"
                                    Style="{StaticResource BlueButton}"
                                    Height="30"
                                    Click="UnsupportedQuickActionButton_Click"
                                    Margin="0,0,0,5"/>

                            <Button x:Name="RemoteControlButton"
                                    Content="REMOTE CONTROL"
                                    Style="{StaticResource ActionButton}"
                                    Height="30"
                                    Click="UnsupportedQuickActionButton_Click"
                                    Margin="0,0,0,5"/>

                            <Button x:Name="SendMessageButton"
                                    Content="SEND MESSAGE"
                                    Style="{StaticResource ActionButton}"
                                    Height="30"
                                    Click="SendMessageButton_Click"
                                    Margin="0,0,0,5"/>

                            <Button x:Name="BlankScreenButton"
                                    Content="BLANK SCREEN"
                                    Style="{StaticResource ActionButton}"
                                    Height="30"
                                    Click="UnsupportedQuickActionButton_Click"
                                    Margin="0,0,0,5"/>

                            <Button x:Name="LockComputerButton"
                                    Content="LOCK COMPUTER"
                                    Style="{StaticResource ActionButton}"
                                    Height="30"
                                    Click="LockComputerButton_Click"
                                    Margin="0,0,0,5"/>

                            <Button x:Name="BlockThisUserButton"
                                    Content="BLOCK THIS USER"
                                    Style="{StaticResource RedButton}"
                                    Height="30"
                                    Click="UnsupportedQuickActionButton_Click"
                                    Margin="0,0,0,5"/>

                            <Button x:Name="LogoffUserButton"
                                    Content="LOG OFF USER"
                                    Style="{StaticResource ActionButton}"
                                    Height="30"
                                    Click="UnsupportedQuickActionButton_Click"
                                    Margin="0,0,0,5"/>

                            <Button x:Name="RestartComputerButton"
                                    Content="RESTART COMPUTER"
                                    Style="{StaticResource ActionButton}"
                                    Height="30"
                                    Click="UnsupportedQuickActionButton_Click"
                                    Margin="0,0,0,5"/>

                            <Button x:Name="ShutdownComputerButton"
                                    Content="SHUTDOWN COMPUTER"
                                    Style="{StaticResource RedButton}"
                                    Height="30"
                                    Click="UnsupportedQuickActionButton_Click"/>

                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Panel}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            Padding="10"
                            Margin="0,10,0,0">

                        <StackPanel>
                            <TextBlock Text="MORE"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}"/>

                            <Button Content="PC DETAILS"
                                    Style="{StaticResource ActionButton}"
                                    Height="29"
                                    Margin="0,8,0,5"
                                    Click="GridViewButton_Click"/>

                            <Button Content="SESSION HISTORY"
                                    Style="{StaticResource ActionButton}"
                                    Height="29"
                                    Margin="0,0,0,5"
                                    Click="ReportsNavButton_Click"/>

                            <Button Content="ACTIVITY LOGS"
                                    Style="{StaticResource ActionButton}"
                                    Height="29"
                                    Click="UnsupportedQuickActionButton_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===================================================== -->
        <!-- HIDDEN ADMIN MODULES - AVAILABLE VIA TABS / NAV -->
        <!-- They remain part of the visual tree for the existing
             code-behind, but are placed below the monitoring view
             instead of competing with live PC screens. -->
        <!-- ===================================================== -->

        <!-- A compact hidden host is unnecessary because the existing
             code-behind may populate the named DataGrids. The fields
             below live in a collapsed TabControl. -->

        <Grid Grid.Column="1"
              Visibility="Collapsed">

            <TabControl x:Name="AdminModulesTab"
                        Background="Transparent"
                        BorderThickness="0">

                <TabItem Header="PC MANAGEMENT"
                         Style="{StaticResource AdminTabItem}">
                    <Border x:Name="PcManagementSection">
                        <StackPanel>
                            <Button Content="ADD PC"
                                    Click="AddPCButton_Click"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="USERS"
                         Style="{StaticResource AdminTabItem}">
                    <Border x:Name="UserManagementSection">
                        <DataGrid x:Name="UserGrid"
                                  AutoGenerateColumns="True"
                                  Height="300"
                                  Style="{StaticResource DarkDataGrid}"/>
                    </Border>
                </TabItem>

                <TabItem Header="ANNOUNCEMENTS"
                         Style="{StaticResource AdminTabItem}">
                    <Border x:Name="AnnouncementSection">
                        <StackPanel>
                            <TextBox x:Name="AnnouncementTitleBox"
                                     Style="{StaticResource DarkTextBox}"/>
                            <TextBox x:Name="AnnouncementMessageBox"
                                     Style="{StaticResource DarkTextBox}"/>
                            <TextBox x:Name="AnnouncementExpirationBox"
                                     Style="{StaticResource DarkTextBox}"/>
                            <Button x:Name="PostAnnouncementButton"
                                    Content="POST ANNOUNCEMENT"
                                    Click="PostAnnouncementButton_Click"/>
                            <DataGrid x:Name="AnnouncementGrid"
                                      Height="250"
                                      Style="{StaticResource DarkDataGrid}"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="SERVICE DESK"
                         Style="{StaticResource AdminTabItem}">
                    <Border x:Name="ServiceDeskSection">
                        <DataGrid x:Name="ServiceDeskGrid"
                                  Height="300"
                                  Style="{StaticResource DarkDataGrid}"/>
                    </Border>
                </TabItem>

                <TabItem Header="ACTIVITY LOGS"
                         Style="{StaticResource AdminTabItem}">
                    <Border x:Name="ActivityLogsSection">
                        <DataGrid x:Name="ActivityLogGrid"
                                  Height="300"
                                  Style="{StaticResource DarkDataGrid}"/>
                    </Border>
                </TabItem>

            </TabControl>

        </Grid>

    </Grid>
</Window>
