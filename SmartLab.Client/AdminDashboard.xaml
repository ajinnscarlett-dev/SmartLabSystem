<Window x:Class="SmartLab.Client.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Lab Management System"
        Width="1550"
        Height="900"
        MinWidth="1250"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>

        <SolidColorBrush x:Key="Bg" Color="#06111A"/>
        <SolidColorBrush x:Key="Panel" Color="#0A1620"/>
        <SolidColorBrush x:Key="Panel2" Color="#0D1B26"/>
        <SolidColorBrush x:Key="Border" Color="#1A3042"/>
        <SolidColorBrush x:Key="Text" Color="#F4F8FB"/>
        <SolidColorBrush x:Key="Muted" Color="#88A0B3"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#102334"/>
        <SolidColorBrush x:Key="ButtonBorder" Color="#22415A"/>
        <SolidColorBrush x:Key="InputBg" Color="#0A1722"/>
        <SolidColorBrush x:Key="GridBg" Color="#08131D"/>
        <SolidColorBrush x:Key="GridAlt" Color="#0E1C27"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#07121C"/>
        <SolidColorBrush x:Key="Blue" Color="#2477FF"/>
        <SolidColorBrush x:Key="Green" Color="#29C76F"/>
        <SolidColorBrush x:Key="Orange" Color="#F08B1A"/>
        <SolidColorBrush x:Key="Red" Color="#E24A4A"/>
        <SolidColorBrush x:Key="Purple" Color="#8E55FF"/>

        <Style x:Key="AdminTabItem"
               TargetType="TabItem">
            <Setter Property="Foreground"
                    Value="{DynamicResource Text}"/>
            <Setter Property="Background"
                    Value="{DynamicResource Panel2}"/>
            <Setter Property="Padding"
                    Value="14,8"/>
            <Setter Property="Margin"
                    Value="0,0,5,0"/>
            <Setter Property="FontSize"
                    Value="10"/>
        </Style>


        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B9C8D5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#102334"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#22415A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#1A5CCC"/>
            <Setter Property="BorderBrush" Value="#2C82FF"/>
        </Style>

        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#11743A"/>
            <Setter Property="BorderBrush" Value="#1CB35D"/>
        </Style>

        <Style x:Key="PurpleButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#5E33B9"/>
            <Setter Property="BorderBrush" Value="#8E55FF"/>
        </Style>

        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#5B2028"/>
            <Setter Property="BorderBrush" Value="#8B313A"/>
        </Style>

        <Style x:Key="DarkDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#08131D"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="RowBackground" Value="#0B1721"/>
            <Setter Property="AlternatingRowBackground" Value="#0E1C27"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#173044"/>
            <Setter Property="VerticalGridLinesBrush" Value="#173044"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#112434"/>
                        <Setter Property="Foreground" Value="#C5D3DE"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="BorderBrush" Value="#20384C"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A1722"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1F394F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#0A1722"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1F394F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,3"/>
        </Style>

    </Window.Resources>


    <Grid Background="{StaticResource Bg}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="205"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="RightSidebarColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- ====================================================== -->
        <!-- SIDEBAR -->
        <!-- ====================================================== -->

        <Border Grid.Column="0"
                Background="{DynamicResource GridBg}"
                BorderBrush="#142B3D"
                BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="110"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,16,10,0">
                    <TextBlock Text="Smart Lab Management System"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}"/>
                    <TextBlock Text="Admin Dashboard"
                               Foreground="{StaticResource Muted}"
                               FontSize="10"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="12,5,12,10">

                        <TextBlock Text="MAIN"
                                   Foreground="#667F92"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="8,10,0,6"/>

                        <Button Style="{StaticResource NavButton}"
                                Background="#0E315D"
                                Foreground="{DynamicResource Text}"
                                Click="DashboardNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌂" Width="26" FontSize="16"/>
                                <TextBlock Text="Dashboard"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="UserManagementNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="♙" Width="26" FontSize="16"/>
                                <TextBlock Text="Users"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="LaboratoriesNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌂" Width="26" FontSize="16"/>
                                <TextBlock Text="Laboratories"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="PcManagementNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="26" FontSize="16"/>
                                <TextBlock Text="Computers"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="ReportsNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▥" Width="26" FontSize="16"/>
                                <TextBlock Text="Schedules"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="ReportsNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◷" Width="26" FontSize="16"/>
                                <TextBlock Text="Reservations"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="ServiceDeskNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" Width="26" FontSize="14"/>
                                <TextBlock Text="Incidents"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="PcManagementNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚒" Width="26" FontSize="15"/>
                                <TextBlock Text="Maintenance"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="ReportsNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▤" Width="26" FontSize="15"/>
                                <TextBlock Text="Reports"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="AnnouncementsNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◈" Width="26" FontSize="15"/>
                                <TextBlock Text="Announcements"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="SettingsNavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Width="26" FontSize="15"/>
                                <TextBlock Text="Settings"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1"
                                Background="#183044"
                                Margin="5,11"/>

                        <TextBlock Text="LABORATORIES"
                                   Foreground="#667F92"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="8,4,0,6"/>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="26" FontSize="15"/>
                                <TextBlock Text="ComLab 101"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Background="#0E315D"
                                Foreground="{DynamicResource Text}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="26" FontSize="15"/>
                                <TextBlock Text="ComLab 601"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="26" FontSize="15"/>
                                <TextBlock Text="ComLab 602"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="26" FontSize="15"/>
                                <TextBlock Text="ComLab 603"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="26" FontSize="15"/>
                                <TextBlock Text="ComLab 604"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="26" FontSize="15"/>
                                <TextBlock Text="ComLab 605"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="26" FontSize="15"/>
                                <TextBlock Text="ComLab 607"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="26" FontSize="15"/>
                                <TextBlock Text="ComLab 609"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                </ScrollViewer>

                <Button Grid.Row="2"
                        Style="{StaticResource PurpleButton}"
                        Margin="14,0,14,15"
                        Height="42"
                        Content="📣  SEND ANNOUNCEMENT"
                        Click="AnnouncementsNavButton_Click"/>

            </Grid>
        </Border>


        <!-- ====================================================== -->
        <!-- MAIN -->
        <!-- ====================================================== -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->

            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBg}"
                    BorderBrush="#142B3D"
                    BorderThickness="0,0,0,1">

                <Grid Margin="18,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              Width="215"
                              Height="38"
                              Style="{StaticResource DarkCombo}"
                              VerticalAlignment="Center"
                              SelectedIndex="1">
                        <ComboBoxItem Content="All Laboratories"/>
                        <ComboBoxItem Content="ComLab 601"/>
                        <ComboBoxItem Content="ComLab 602"/>
                        <ComboBoxItem Content="ComLab 603"/>
                        <ComboBoxItem Content="ComLab 604"/>
                    </ComboBox>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Background="{DynamicResource InputBg}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,8"
                                Margin="0,0,8,0">
                            <TextBlock Text="LIVE MONITORING"
                                       Foreground="#AFC3D2"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <Button Content="REFRESH"
                                Style="{StaticResource BlueButton}"
                                Width="85"
                                Height="34"
                                Click="RefreshButton_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button x:Name="ThemeToggleButton"
                                Width="48"
                                Height="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource ActionButton}"
                                Content="☾"
                                ToolTip="Switch dark/light mode"
                                Click="HeaderThemeButton_Click"/>

                        <Grid Width="48"
                              Height="36"
                              Margin="0,0,8,0">

                            <Button x:Name="NotificationButton"
                                    Width="48"
                                    Height="36"
                                    Style="{StaticResource ActionButton}"
                                    Content="🔔"
                                    ToolTip="Notifications"
                                    Click="HeaderBellButton_Click"/>

                            <Border x:Name="NotificationBadge"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="9"
                                    Background="{StaticResource Red}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-5,-5,0"
                                    Visibility="Collapsed">

                                <TextBlock x:Name="NotificationCountText"
                                           Text="0"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>
                            </Border>

                        </Grid>

                        <Button Width="110"
                                Height="36"
                                Style="{StaticResource ActionButton}"
                                Content="Admin  ▾"
                                Click="ProfileButton_Click"/>

                        <Button Width="82"
                                Height="36"
                                Margin="8,0,0,0"
                                Style="{StaticResource RedButton}"
                                Content="LOGOUT"
                                Click="LogoutButton_Click"/>

                    </StackPanel>

                </Grid>
            </Border>


            <!-- CONTENT -->

            <ScrollViewer x:Name="MainScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="14,14,14,30">


                    <!-- TOP SUMMARY -->

                    <UniformGrid Rows="1"
                                 Columns="6"
                                 Margin="0,0,0,14">

                        <Border Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Margin="3"
                                Padding="13">
                            <StackPanel>
                                <TextBlock Text="TOTAL LABORATORIES"
                                           Foreground="#9BAFC0"
                                           FontSize="9"/>
                                <TextBlock Text="8"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Text}"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="Active Laboratories"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="9"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Margin="3"
                                Padding="13">
                            <StackPanel>
                                <TextBlock Text="TOTAL COMPUTERS"
                                           Foreground="#9BAFC0"
                                           FontSize="9"/>
                                <TextBlock x:Name="TotalPcText"
                                           Text="0"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Text}"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="All Computers"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="9"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Margin="3"
                                Padding="13">
                            <StackPanel>
                                <TextBlock Text="ONLINE"
                                           Foreground="#9BAFC0"
                                           FontSize="9"/>
                                <TextBlock x:Name="AvailablePcText"
                                           Text="0"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Green}"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="Available / Online"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="9"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Margin="3"
                                Padding="13">
                            <StackPanel>
                                <TextBlock Text="IN USE"
                                           Foreground="#9BAFC0"
                                           FontSize="9"/>
                                <TextBlock x:Name="OccupiedPcText"
                                           Text="0"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Blue}"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="Currently occupied"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="9"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Margin="3"
                                Padding="13">
                            <StackPanel>
                                <TextBlock Text="MAINTENANCE"
                                           Foreground="#9BAFC0"
                                           FontSize="9"/>
                                <TextBlock x:Name="MaintenancePcText"
                                           Text="0"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Orange}"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="Needs attention"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="9"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Margin="3"
                                Padding="13">
                            <StackPanel>
                                <TextBlock Text="OFFLINE / IDLE"
                                           Foreground="#9BAFC0"
                                           FontSize="9"/>
                                <TextBlock x:Name="OfflinePcText"
                                           Text="0"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Foreground="#A8B3BD"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="No recent heartbeat"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="9"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>


                    <!-- LIVE MONITORING AREA -->

                    <Grid x:Name="LiveMonitoringSection">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="285"/>
                        </Grid.ColumnDefinitions>


                        <!-- PC GRID -->

                        <Border Grid.Column="0"
                                Background="#07121B"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,10,10">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="24"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="COMLAB 601"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}"/>
                                        <TextBlock Text="  •  "
                                                   Foreground="#4E6476"/>
                                        <TextBlock Text="COMPUTER MONITORING"
                                                   Foreground="#8095A6"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="Auto refreshed"
                                               Foreground="#71889A"
                                               FontSize="9"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>

                                </Grid>

                                <ScrollViewer Grid.Row="1"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">

                                    <UniformGrid x:Name="PcGrid"
                                                 Columns="10"
                                                 Margin="0,3,0,3"/>

                                </ScrollViewer>

                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="● Online"
                                               Foreground="{StaticResource Green}"
                                               FontSize="10"
                                               Margin="4,0,16,0"/>
                                    <TextBlock Text="● In Use"
                                               Foreground="{StaticResource Blue}"
                                               FontSize="10"
                                               Margin="4,0,16,0"/>
                                    <TextBlock Text="● Maintenance"
                                               Foreground="{StaticResource Orange}"
                                               FontSize="10"
                                               Margin="4,0,16,0"/>
                                    <TextBlock Text="● Offline / Idle"
                                               Foreground="#9DAAB5"
                                               FontSize="10"
                                               Margin="4,0,16,0"/>

                                    <Button Content="GRID VIEW"
                                            Style="{StaticResource ActionButton}"
                                            Width="78"
                                            Height="24"
                                            FontSize="9"
                                            Margin="0,0,5,0"
                                            HorizontalAlignment="Right"
                                            Click="ClearSelectedPcButton_Click"/>

                                    <Button Content="LIST VIEW"
                                            Style="{StaticResource ActionButton}"
                                            Width="78"
                                            Height="24"
                                            FontSize="9"
                                            Click="ListViewButton_Click"/>

                                </StackPanel>

                            </Grid>
                        </Border>


                        <!-- RIGHT PC PANEL -->

                        <StackPanel Grid.Column="1">



                            <Border Background="{StaticResource Panel}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="13"
                                    Margin="0,10,0,0">

                                <StackPanel>
                                    <TextBlock Text="SYSTEM STATUS"
                                               Foreground="{DynamicResource Text}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>

                                    <TextBlock x:Name="ApiStatusText"
                                               Text="Connecting..."
                                               Foreground="{StaticResource Muted}"
                                               FontSize="9"
                                               TextWrapping="Wrap"
                                               Margin="0,7,0,0"/>

                                    <TextBlock Text="● Server    Online"
                                               Foreground="{StaticResource Green}"
                                               FontSize="9"
                                               Margin="0,7,0,0"/>
                                    <TextBlock Text="● Database  Online"
                                               Foreground="{StaticResource Green}"
                                               FontSize="9"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="● LAN       Online"
                                               Foreground="{StaticResource Green}"
                                               FontSize="9"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                    </Grid>


                    <!-- BOTTOM SUMMARY -->

                    <Grid Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1.0*"/>
                        </Grid.ColumnDefinitions>


                        <!-- SYSTEM HEALTH -->

                        <Border Grid.Column="0"
                                Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,7,0">

                            <StackPanel>

                                <Grid>
                                    <TextBlock Text="SYSTEM HEALTH"
                                               Foreground="{DynamicResource Text}"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="View Details"
                                               Foreground="#4896FF"
                                               HorizontalAlignment="Right"
                                               FontSize="10"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,12,0,0">

                                    <Border Width="105"
                                            Height="105"
                                            CornerRadius="55"
                                            BorderBrush="#2EAD59"
                                            BorderThickness="8"
                                            Background="{DynamicResource Panel2}"
                                            Margin="0,0,18,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="98%"
                                                       Foreground="{DynamicResource Text}"
                                                       FontSize="23"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Excellent"
                                                       Foreground="{StaticResource Green}"
                                                       FontSize="9"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Network   99%"
                                                   Foreground="#B6C8D6"
