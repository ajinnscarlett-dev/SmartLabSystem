<Window x:Class="SmartLab.Client.AdminServiceDeskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Service Desk"
        Width="1300"
        Height="760"
        MinWidth="1000"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource SmartLabButtonBase}">
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="MinWidth" Value="95"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SmartLabPrimaryButton}">
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="MinWidth" Value="95"/>
        </Style>
        <Style x:Key="DarkGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SmartLabSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource SmartLabText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SmartLabBorder}"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F7F9FB"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E7EC"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SmartLabSurface}"
                BorderBrush="{StaticResource SmartLabBorder}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SERVICE DESK" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Teacher incidents and MIS resolution queue" Foreground="{StaticResource SmartLabMuted}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource SmartLabMuted}" Margin="0,0,14,0"/>
                    <Button Content="REFRESH" Style="{StaticResource PrimaryButton}" Click="Refresh_Click"/>
                    <Button Content="CLOSE" Style="{StaticResource ActionButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <DockPanel Margin="12">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button Content="START / REPLY" Style="{StaticResource ActionButton}" Click="Start_Click"/>
                <Button Content="RESOLVE" Style="{StaticResource PrimaryButton}" Click="Resolve_Click"/>
                <Button Content="REFRESH" Style="{StaticResource ActionButton}" Click="Refresh_Click"/>
            </WrapPanel>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="190"/></Grid.RowDefinitions>
                <DataGrid x:Name="TicketGrid" Style="{StaticResource DarkGrid}" SelectionMode="Single"/>
                <Border Grid.Row="1"
                        Background="{StaticResource SmartLabSurface}"
                        BorderBrush="{StaticResource SmartLabBorder}"
                        BorderThickness="1"
                        Padding="12"
                        Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Response / resolution" VerticalAlignment="Top"/>
                        <TextBox x:Name="ResponseText"
                                 Grid.Column="1"
                                 Height="105"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8"/>
                        <TextBlock Grid.Row="1" Text="Assigned to" Margin="0,9,0,0"/>
                        <TextBox x:Name="AssignedToText" Grid.Row="1" Grid.Column="1" Height="32" Padding="8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SelectedTicketText" Foreground="{StaticResource SmartLabMuted}" Margin="0,9,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
