<Window x:Class="SmartLab.Client.AdminServiceDeskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Service Desk"
        Width="1300" Height="760" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#081018" Foreground="#E9EEF2"
        FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#14232D"/><Setter Property="Foreground" Value="#E9EEF2"/>
            <Setter Property="BorderBrush" Value="#2A3A45"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="MinWidth" Value="95"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="Background" Value="#215D9F"/></Style>
        <Style x:Key="DarkGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#0A141B"/><Setter Property="Foreground" Value="#E9EEF2"/>
            <Setter Property="RowBackground" Value="#0C171E"/><Setter Property="AlternatingRowBackground" Value="#101C24"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="RowHeight" Value="34"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#0B141B" BorderBrush="#1C2B34" BorderThickness="0,0,0,1" Padding="18,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="SERVICE DESK" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Teacher incidents and MIS resolution queue" Foreground="#8B9AA5" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#8B9AA5" Margin="0,0,14,0"/><Button Content="REFRESH" Style="{StaticResource PrimaryButton}" Click="Refresh_Click"/><Button Content="CLOSE" Style="{StaticResource ActionButton}" Click="Close_Click"/></StackPanel>
            </Grid>
        </Border>
        <DockPanel Margin="12">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button Content="START / REPLY" Style="{StaticResource ActionButton}" Click="Start_Click"/>
                <Button Content="RESOLVE" Style="{StaticResource ActionButton}" Click="Resolve_Click"/>
                <Button Content="REFRESH" Style="{StaticResource ActionButton}" Click="Refresh_Click"/>
            </WrapPanel>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="190"/></Grid.RowDefinitions>
                <DataGrid x:Name="TicketGrid" Style="{StaticResource DarkGrid}" SelectionMode="Single"/>
                <Border Grid.Row="1" Background="#0D171F" BorderBrush="#253742" BorderThickness="1" Padding="12" Margin="0,10,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Response / resolution" VerticalAlignment="Top"/><TextBox x:Name="ResponseText" Grid.Column="1" Height="105" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#101C24" Foreground="#E9EEF2" BorderBrush="#2A3A45" Padding="8"/>
                        <TextBlock Grid.Row="1" Text="Assigned to" Margin="0,9,0,0"/><TextBox x:Name="AssignedToText" Grid.Row="1" Grid.Column="1" Height="32" Background="#101C24" Foreground="#E9EEF2" BorderBrush="#2A3A45" Padding="8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SelectedTicketText" Foreground="#8B9AA5" Margin="0,9,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
