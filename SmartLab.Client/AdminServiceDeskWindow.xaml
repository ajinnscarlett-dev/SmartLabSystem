<Window x:Class="SmartLab.Client.AdminServiceDeskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLabSystem — Service Desk"
        Width="1260" Height="760" MinWidth="1080" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartLabPageBackground}"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Service Desk" Style="{StaticResource SmartLabPageTitle}"/>
                <TextBlock Text="Review, assign, respond to, and resolve operational requests." Style="{StaticResource SmartLabCaption}" Margin="0,3,0,0"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready" Style="{StaticResource SmartLabCaption}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="REFRESH" Width="82" Height="34" Click="Refresh_Click"/>
                <Button Content="CLOSE" Width="78" Height="34" Margin="8,0,0,0" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SmartLabSectionBorder}" Padding="0" Margin="0,0,8,0">
                <DataGrid x:Name="TicketGrid" Style="{StaticResource SmartLabDataGrid}" SelectionChanged="TicketGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ServiceDeskTicketId}" Width="60"/>
                        <DataGridTextColumn Header="REQUESTER" Binding="{Binding TeacherUsername}" Width="120"/>
                        <DataGridTextColumn Header="PC" Binding="{Binding PCNumber}" Width="72"/>
                        <DataGridTextColumn Header="SUBJECT" Binding="{Binding Subject}" Width="*"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="92"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SmartLabSectionBorder}" Padding="18" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="TICKET DETAILS" Style="{StaticResource SmartLabSectionTitle}"/>
                        <TextBlock x:Name="SelectedTicketText" Text="Select a request" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,14"/>
                        <TextBlock Text="ASSIGNED TO" Style="{StaticResource SmartLabCaption}"/>
                        <TextBlock x:Name="AssignedToText" Text="—" Margin="0,4,0,14"/>
                        <Border Height="1" Background="{StaticResource SmartLabBorder}" Margin="0,0,0,14"/>
                        <TextBlock Text="RESPONSE" Style="{StaticResource SmartLabCaption}"/>
                        <TextBox x:Name="ResponseText" Height="150" Margin="0,6,0,14" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="START" Width="82" Height="34" Margin="0,0,8,0" Style="{StaticResource SmartLabButtonBase}" Click="Start_Click"/>
                            <Button Content="RESOLVE" Width="92" Height="34" Style="{StaticResource SmartLabPrimaryButton}" Click="Resolve_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="Use actual ticket data only; empty queues remain intentionally empty." Style="{StaticResource SmartLabCaption}" Margin="2,10,0,0"/>
    </Grid>
</Window>