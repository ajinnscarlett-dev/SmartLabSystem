<Window x:Class="SmartLab.Client.AdminServiceDeskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Service Desk"
        Width="1320" Height="760" MinWidth="1050" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SERVICE DESK" Style="{StaticResource SmartLabPageTitle}"/>
                <TextBlock Text="Review, assign, respond to, and resolve operational support requests."
                           Style="{StaticResource SmartLabCaption}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Style="{StaticResource SmartLabCaption}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Button Content="REFRESH" Width="90" Style="{StaticResource SmartLabPrimaryButton}" Click="Refresh_Click"/>
                <Button Content="CLOSE" Width="80" Margin="8,0,0,0" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SmartLabToolbarBorder}" Margin="0,0,0,12">
            <WrapPanel>
                <Button Content="START / REPLY" Margin="0,0,7,0" Click="Start_Click"/>
                <Button Content="RESOLVE" Style="{StaticResource SmartLabPrimaryButton}" Click="Resolve_Click"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SmartLabSectionBorder}" Padding="0" Margin="0,0,8,0">
                <DataGrid x:Name="TicketGrid" Style="{StaticResource SmartLabDataGrid}" SelectionMode="Single"/>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SmartLabSectionBorder}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="SELECTED REQUEST" Style="{StaticResource SmartLabSectionTitle}"/>
                    <TextBlock x:Name="SelectedTicketText" Grid.Row="1" Text="" TextWrapping="Wrap" Margin="0,5,0,12"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="ASSIGN TO" Style="{StaticResource SmartLabCaption}" VerticalAlignment="Center"/>
                        <TextBox x:Name="AssignedToText" Grid.Column="1" Height="34"/>
                    </Grid>
                    <TextBox x:Name="ResponseText" Grid.Row="3" Margin="0,12,0,12"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Grid.Row="4" Text="Write a response or resolution note before resolving a selected request."
                               Style="{StaticResource SmartLabCaption}" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>