<Window x:Class="SmartLab.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Student Login"
        Width="500" Height="590" MinWidth="500" MinHeight="590"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SMARTLABSYSTEM" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Student Workstation Login" Style="{StaticResource SmartLabCaption}" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" BorderBrush="{StaticResource SmartLabBorder}" BorderThickness="1"
                    Background="{StaticResource SmartLabSurfaceAlt}" Padding="9,5" VerticalAlignment="Center">
                <TextBlock Text="STUDENT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SmartLabAccent}"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Use your SmartLab student credentials to sign in." Style="{StaticResource SmartLabCaption}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="TEACHER LOGIN" Width="112" Height="30" Style="{StaticResource SmartLabPrimaryButton}"
                        Margin="0,0,7,0" Click="TeacherLoginButton_Click"/>
                <Button x:Name="AdminSettingsButton" Content="MANAGEMENT" Width="104" Height="30"
                        Click="AdminLoginButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" MaxWidth="390" Padding="30"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Style="{StaticResource SmartLabSectionBorder}">
            <StackPanel>
                <TextBlock Text="SIGN IN" Style="{StaticResource SmartLabSectionTitle}" FontSize="16"/>
                <TextBlock Text="Student Number / Username" Style="{StaticResource SmartLabCaption}" Margin="0,4,0,18"/>

                <TextBlock Text="USERNAME" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}"/>
                <TextBox x:Name="UsernameTextBox" Margin="0,6,0,16"/>

                <TextBlock Text="PASSWORD" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,6,0,20"/>

                <Button x:Name="LoginButton" Content="SIGN IN"
                        Style="{StaticResource SmartLabPrimaryButton}" Height="42"
                        Click="LoginButton_Click"/>

                <TextBlock x:Name="StatusText" Margin="0,14,0,0"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource SmartLabMuted}"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="SmartLab Server and workstation presence are verified during sign in."
                   Style="{StaticResource SmartLabCaption}" HorizontalAlignment="Center"
                   Margin="0,16,0,0"/>
    </Grid>
</Window>