<Window x:Class="SmartLab.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Student Login"
        Height="520"
        Width="460"
        MinHeight="520"
        MinWidth="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource SmartLabPageBackground}"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Content="TEACHER LOGIN"
                    Width="112"
                    Height="30"
                    Margin="0,0,8,0"
                    Style="{StaticResource SmartLabPrimaryButton}"
                    ToolTip="Teacher Login"
                    Click="TeacherLoginButton_Click"/>
            <Button x:Name="AdminSettingsButton"
                    Content="MANAGEMENT"
                    Width="108"
                    Height="30"
                    ToolTip="Management Login"
                    Click="AdminLoginButton_Click"/>
        </StackPanel>

        <Border Width="360"
                Padding="28"
                Background="{StaticResource SmartLabSurface}"
                BorderBrush="{StaticResource SmartLabBorder}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="SMARTLABSYSTEM"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SmartLabText}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Student Workstation Login"
                           FontSize="12"
                           Foreground="{StaticResource SmartLabMuted}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,24"/>

                <TextBlock Text="Username"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SmartLabText}"/>
                <TextBox x:Name="UsernameTextBox"
                         Margin="0,6,0,16"/>

                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SmartLabText}"/>
                <PasswordBox x:Name="PasswordBox"
                             Margin="0,6,0,20"/>

                <Button x:Name="LoginButton"
                        Content="SIGN IN"
                        Style="{StaticResource SmartLabPrimaryButton}"
                        Height="42"
                        Click="LoginButton_Click"/>

                <TextBlock x:Name="StatusText"
                           Text=""
                           Margin="0,14,0,0"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{StaticResource SmartLabMuted}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
