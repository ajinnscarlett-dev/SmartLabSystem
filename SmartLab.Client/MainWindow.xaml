<Window x:Class="SmartLab.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLabSystem — Student Login"
        Width="760" Height="560" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SmartLabPageBackground}">
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="0.95*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SmartLabText}" Padding="28">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SMARTLABSYSTEM" Foreground="White" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="School laboratory operations platform" Foreground="#C8D3DD" FontSize="12" Margin="0,5,0,26"/>
                <Border BorderBrush="#495865" BorderThickness="0,1,0,0" Margin="0,0,0,20"/>
                <TextBlock Text="STUDENT WORKSTATION" Foreground="#AFC2D0" FontSize="10" FontWeight="SemiBold"/>
                <TextBlock Text="Sign in to continue to your assigned workstation." Foreground="White"
                           FontSize="16" FontWeight="SemiBold" Margin="0,7,0,8" TextWrapping="Wrap"/>
                <TextBlock Text="SmartLab verifies the local server and workstation identity during sign in."
                           Foreground="#B9C7D2" FontSize="11" TextWrapping="Wrap" MaxWidth="330"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Student Login" Style="{StaticResource SmartLabPageTitle}"/>
                    <TextBlock Text="Use your SmartLab student credentials." Style="{StaticResource SmartLabCaption}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{StaticResource SmartLabAccentSoft}" BorderBrush="{StaticResource SmartLabBorder}" BorderThickness="1" Padding="9,5">
                    <TextBlock Text="STUDENT" Foreground="{StaticResource SmartLabAccent}" FontSize="10" FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource SmartLabSectionBorder}" Padding="22" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="CREDENTIALS" Style="{StaticResource SmartLabSectionTitle}"/>
                    <TextBlock Text="Student number or username" Style="{StaticResource SmartLabCaption}" Margin="0,4,0,18"/>

                    <TextBlock Text="USERNAME" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}"/>
                    <TextBox x:Name="UsernameTextBox" Margin="0,6,0,14"/>

                    <TextBlock Text="PASSWORD" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}"/>
                    <PasswordBox x:Name="PasswordBox" Margin="0,6,0,18"/>

                    <Button x:Name="LoginButton" Content="SIGN IN" Height="40" Style="{StaticResource SmartLabPrimaryButton}" Click="LoginButton_Click"/>
                    <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource SmartLabMuted}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="TEACHER LOGIN" Style="{StaticResource SmartLabButtonBase}" Width="118" Height="32" Click="TeacherLoginButton_Click"/>
                    <Button x:Name="AdminSettingsButton" Content="MANAGEMENT" Style="{StaticResource SmartLabButtonBase}" Width="110" Height="32" Margin="8,0,0,0" Click="AdminLoginButton_Click"/>
                </StackPanel>
                <TextBlock Text="SmartLab Server • Workstation verification" Style="{StaticResource SmartLabCaption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>