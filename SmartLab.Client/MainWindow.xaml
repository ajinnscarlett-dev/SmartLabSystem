<Window x:Class="SmartLab.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab Login"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F4F6F9">

        <!-- ========================================== -->
        <!-- ADMIN / SETTINGS BUTTON -->
        <!-- ========================================== -->

        <Button x:Name="AdminSettingsButton"
                Content="⚙"
                Width="40"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,15,15,0"
                FontSize="22"
                Background="Transparent"
                BorderThickness="0"
                ToolTip="Management Login"
                Click="AdminLoginButton_Click"/>


        <!-- ========================================== -->
        <!-- LOGIN FORM -->
        <!-- ========================================== -->

        <Border Width="360"
                Padding="30"
                Background="White"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <!-- TITLE -->

                <TextBlock Text="SmartLab"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#182536"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Computer Laboratory System"
                           FontSize="14"
                           Foreground="#65758A"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,30"/>


                <!-- USERNAME -->

                <TextBlock Text="Username"
                           FontWeight="SemiBold"
                           Foreground="#182536"/>

                <TextBox x:Name="UsernameTextBox"
                         Height="38"
                         Margin="0,6,0,18"
                         Padding="8"/>


                <!-- PASSWORD -->

                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Foreground="#182536"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="38"
                             Margin="0,6,0,22"
                             Padding="8"/>


                <!-- LOGIN -->

                <Button Content="LOGIN"
                        Height="42"
                        FontWeight="Bold"
                        Background="#182536"
                        Foreground="White"
                        BorderThickness="0"
                        Click="LoginButton_Click"/>


                <!-- STATUS -->

                <TextBlock x:Name="StatusText"
                           Text=""
                           Margin="0,15,0,0"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="#65758A"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>