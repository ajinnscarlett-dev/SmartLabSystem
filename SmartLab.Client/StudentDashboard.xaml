<Window x:Class="SmartLab.Client.StudentDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Student"
        Width="980" Height="640" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SmartLabToolbarBorder}" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="STUDENT WORKSTATION" Style="{StaticResource SmartLabPageTitle}" FontSize="20"/>
                    <TextBlock Text="SmartLab account and workstation session" Style="{StaticResource SmartLabCaption}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="WelcomeText" Text="Welcome, Student" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Text="STUDENT" Style="{StaticResource SmartLabCaption}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SmartLabSectionBorder}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="ACCOUNT" Style="{StaticResource SmartLabCaption}"/>
                    <TextBlock x:Name="UsernameText" Text="Username" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <TextBlock Text="Student account" Style="{StaticResource SmartLabCaption}"/>
                    <Border Height="1" Background="{StaticResource SmartLabBorder}" Margin="0,18,0,14"/>
                    <TextBlock Text="SESSION" Style="{StaticResource SmartLabCaption}"/>
                    <TextBlock Text="Current workstation session" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <TextBlock Text="Use the dedicated SmartLab workstation widget for active PC controls and assistance."
                               Style="{StaticResource SmartLabCaption}" TextWrapping="Wrap"/>
                    <Button Content="MY PROFILE" Width="120" Margin="0,18,0,0"
                            Click="ProfileButton_Click"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource SmartLabSectionBorder}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="PASSWORD &amp; ACCOUNT" Style="{StaticResource SmartLabCaption}"/>
                        <TextBlock Text="Keep your account secure" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,3"/>
                        <TextBlock Text="Change your password through the authenticated server workflow."
                                   Style="{StaticResource SmartLabCaption}" TextWrapping="Wrap"/>
                        <Button Content="CHANGE PASSWORD" Width="150" Margin="0,18,0,0"
                                Style="{StaticResource SmartLabPrimaryButton}" Click="ChangePasswordButton_Click"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource SmartLabSectionBorder}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="SIGN OUT" Style="{StaticResource SmartLabCaption}"/>
                        <TextBlock Text="End the current session" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,3"/>
                        <TextBlock Text="Sign out when you are finished using this workstation."
                                   Style="{StaticResource SmartLabCaption}" TextWrapping="Wrap"/>
                        <Button Content="LOGOUT" Width="100" Margin="0,18,0,0"
                                Style="{StaticResource SmartLabDangerButton}" Click="LogoutButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>