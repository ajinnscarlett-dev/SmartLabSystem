<Window x:Class="SmartLab.Client.StudentDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLabSystem — Student"
        Width="980" Height="650" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SmartLabPageBackground}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SmartLabToolbarBorder}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SmartLabSystem" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Student workstation" Style="{StaticResource SmartLabCaption}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="WelcomeText" Text="Welcome, Student" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Text="STUDENT" Style="{StaticResource SmartLabCaption}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,14">
            <StackPanel>
                <TextBlock Text="Student Dashboard" Style="{StaticResource SmartLabPageTitle}"/>
                <TextBlock Text="Your account and current workstation session." Style="{StaticResource SmartLabCaption}" Margin="0,3,0,0"/>
            </StackPanel>
            <TextBlock Text="ACTIVE SESSION" Foreground="{StaticResource SmartLabSuccess}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SmartLabSectionBorder}" Margin="0,0,8,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="CURRENT COMPUTER" Style="{StaticResource SmartLabCaption}"/>
                    <TextBlock Text="Your active SmartLab workstation" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,4"/>
                    <TextBlock Text="The dedicated workstation widget contains the active PC controls, assistance, notifications, and session actions." Style="{StaticResource SmartLabCaption}" TextWrapping="Wrap"/>

                    <Border Background="{StaticResource SmartLabAccentSoft}" BorderBrush="{StaticResource SmartLabBorder}" BorderThickness="1" Padding="14" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="SESSION" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource SmartLabAccent}"/>
                            <TextBlock Text="Connected to SmartLab workstation" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,3"/>
                            <TextBlock Text="Use the SmartLab workstation window for live session functions." Style="{StaticResource SmartLabCaption}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Button Content="MY PROFILE" Width="110" Height="34" Margin="0,18,0,0" Style="{StaticResource SmartLabButtonBase}" Click="ProfileButton_Click"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource SmartLabSectionBorder}" Padding="18" Margin="0,0,0,7">
                    <StackPanel>
                        <TextBlock Text="ACCOUNT SECURITY" Style="{StaticResource SmartLabCaption}"/>
                        <TextBlock Text="Change password" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,4"/>
                        <TextBlock Text="Update your password through the authenticated server workflow." Style="{StaticResource SmartLabCaption}" TextWrapping="Wrap"/>
                        <Button Content="CHANGE PASSWORD" Width="150" Height="36" Margin="0,16,0,0" Style="{StaticResource SmartLabPrimaryButton}" Click="ChangePasswordButton_Click"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource SmartLabSectionBorder}" Padding="18" Margin="0,7,0,0">
                    <StackPanel>
                        <TextBlock Text="END SESSION" Style="{StaticResource SmartLabCaption}"/>
                        <TextBlock Text="Sign out when finished" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,4"/>
                        <TextBlock Text="This ends the current SmartLab session and returns to login." Style="{StaticResource SmartLabCaption}" TextWrapping="Wrap"/>
                        <Button Content="LOGOUT" Width="100" Height="36" Margin="0,16,0,0" Style="{StaticResource SmartLabDangerButton}" Click="LogoutButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>