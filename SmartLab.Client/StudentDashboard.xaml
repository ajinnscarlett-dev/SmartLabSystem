<Window x:Class="SmartLab.Client.StudentDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Student"
        Width="980"
        Height="620"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}"
        FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SmartLabSurface}"
                BorderBrush="{StaticResource SmartLabBorder}"
                BorderThickness="1"
                Padding="16"
                Margin="0,0,0,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="SMARTLAB" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Student Workstation" FontSize="12" Foreground="{StaticResource SmartLabMuted}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="WelcomeText" Text="Welcome, Student" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Text="Student" FontSize="11" Foreground="{StaticResource SmartLabMuted}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="My SmartLab Session" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Manage your account and current workstation session." FontSize="12" Foreground="{StaticResource SmartLabMuted}" Margin="0,3,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource SmartLabSurface}" BorderBrush="{StaticResource SmartLabBorder}" BorderThickness="1" Padding="18" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="ACCOUNT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}"/>
                        <TextBlock x:Name="UsernameText" Text="Username" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,5"/>
                        <TextBlock Text="Role: Student" FontSize="12" Foreground="{StaticResource SmartLabMuted}"/>
                        <Button Content="MY PROFILE" Margin="0,20,0,0" Click="ProfileButton_Click"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource SmartLabSurface}" BorderBrush="{StaticResource SmartLabBorder}" BorderThickness="1" Padding="18" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="SECURITY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}"/>
                        <TextBlock Text="Password" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,5"/>
                        <TextBlock Text="Update your account password when necessary." FontSize="12" Foreground="{StaticResource SmartLabMuted}" TextWrapping="Wrap"/>
                        <Button Content="CHANGE PASSWORD" Style="{StaticResource SmartLabPrimaryButton}" Margin="0,20,0,0" Click="ChangePasswordButton_Click"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource SmartLabSurface}" BorderBrush="{StaticResource SmartLabBorder}" BorderThickness="1" Padding="18" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="SESSION" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}"/>
                        <TextBlock Text="Current session" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,5"/>
                        <TextBlock Text="Sign out when you are finished using this workstation." FontSize="12" Foreground="{StaticResource SmartLabMuted}" TextWrapping="Wrap"/>
                        <Button Content="LOGOUT" Style="{StaticResource SmartLabDangerButton}" Margin="0,20,0,0" Click="LogoutButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
