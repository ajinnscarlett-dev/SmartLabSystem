<Window x:Class="SmartLab.Client.StudentDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab - Student Dashboard"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F7FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#1F2937"
                Padding="25">

            <Grid>

                <TextBlock Text="SmartLab"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="WelcomeText"
                               Text="Welcome, Student"
                               Foreground="White"
                               FontSize="16"
                               HorizontalAlignment="Right"/>

                    <TextBlock Text="Student"
                               Foreground="#D1D5DB"
                               FontSize="13"
                               HorizontalAlignment="Right"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1"
              Margin="35">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>

                <TextBlock Text="Student Dashboard"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <TextBlock Text="Computer Laboratory Management System"
                           FontSize="15"
                           Foreground="#6B7280"
                           Margin="0,5,0,25"/>

            </StackPanel>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ACCOUNT -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="10"
                        Margin="10"
                        Padding="25">

                    <StackPanel>

                        <TextBlock Text="My Account"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>

                        <TextBlock x:Name="UsernameText"
                                   Text="Username"
                                   FontSize="15"
                                   Margin="0,15,0,5"/>

                        <TextBlock Text="Role: Student"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,20"/>

                        <Button Content="MY PROFILE"
                                Height="40"
                                Click="ProfileButton_Click"/>

                    </StackPanel>

                </Border>

                <!-- CHANGE PASSWORD -->
                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="10"
                        Margin="10"
                        Padding="25">

                    <StackPanel>

                        <TextBlock Text="Password"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>

                        <TextBlock Text="Keep your account secure by changing your password."
                                   TextWrapping="Wrap"
                                   Foreground="#6B7280"
                                   Margin="0,15,0,20"/>

                        <Button Content="CHANGE PASSWORD"
                                Height="40"
                                Click="ChangePasswordButton_Click"/>

                    </StackPanel>

                </Border>

                <!-- LOGOUT -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="10"
                        Margin="10"
                        Padding="25">

                    <StackPanel>

                        <TextBlock Text="Session"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>

                        <TextBlock Text="End your current SmartLab session."
                                   TextWrapping="Wrap"
                                   Foreground="#6B7280"
                                   Margin="0,15,0,20"/>

                        <Button Content="LOGOUT"
                                Height="40"
                                Click="LogoutButton_Click"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>