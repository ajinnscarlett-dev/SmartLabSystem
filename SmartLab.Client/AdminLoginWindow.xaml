<Window x:Class="SmartLab.Client.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Management Login"
        Height="470"
        Width="430"
        MinHeight="470"
        MinWidth="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Border Width="360"
                Padding="28"
                Background="{StaticResource SmartLabSurface}"
                BorderBrush="{StaticResource SmartLabBorder}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="SMARTLABSYSTEM"
                           FontSize="23"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SmartLabText}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Management / MIS Login"
                           FontSize="12"
                           Foreground="{StaticResource SmartLabMuted}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,24"/>
                <TextBlock Text="Username"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SmartLabText}"/>
                <TextBox x:Name="UsernameTextBox" Margin="0,6,0,16"/>
                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SmartLabText}"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,6,0,20"/>
                <Button x:Name="LoginButton"
                        Content="SIGN IN"
                        Height="42"
                        Style="{StaticResource SmartLabPrimaryButton}"
                        Click="LoginButton_Click"/>
                <TextBlock x:Name="StatusText"
                           Text=""
                           Margin="0,14,0,0"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{StaticResource SmartLabMuted}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
