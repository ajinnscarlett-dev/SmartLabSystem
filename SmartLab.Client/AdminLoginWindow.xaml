<Window x:Class="SmartLab.Client.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Management Login"
        Height="470"
        Width="430"
        MinHeight="470"
        MinWidth="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F5F8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Border" Color="#D9E0E7"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="Accent" Color="#2467A9"/>

        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Border Width="360"
                Padding="28"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="SMARTLAB"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Management / MIS Login"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,24"/>

                <TextBlock Text="Username"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBox x:Name="UsernameTextBox"
                         Style="{StaticResource Field}"
                         Margin="0,6,0,16"/>

                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource Field}"
                             Margin="0,6,0,20"/>

                <Button x:Name="LoginButton"
                        Content="LOGIN"
                        Style="{StaticResource PrimaryButton}"
                        Click="LoginButton_Click"/>

                <TextBlock x:Name="StatusText"
                           Text=""
                           Margin="0,14,0,0"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
