<Window x:Class="SmartLab.Client.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Management Login"
        Width="460" Height="520" MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="BACK" Style="{StaticResource SmartLabBackButton}"
                HorizontalAlignment="Left" Click="BackButton_Click"/>

        <Border Grid.Row="1" MaxWidth="370" Padding="30" Margin="0,22,0,18"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Style="{StaticResource SmartLabSectionBorder}">
            <StackPanel>
                <TextBlock Text="SMARTLABSYSTEM" FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Management / MIS" Style="{StaticResource SmartLabCaption}"
                           HorizontalAlignment="Center" Margin="0,4,0,26"/>

                <TextBlock Text="USERNAME" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource SmartLabMuted}"/>
                <TextBox x:Name="UsernameTextBox" Margin="0,6,0,16"/>

                <TextBlock Text="PASSWORD" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource SmartLabMuted}"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,6,0,20"/>

                <Button x:Name="LoginButton" Content="SIGN IN"
                        Style="{StaticResource SmartLabPrimaryButton}" Height="42"
                        Click="LoginButton_Click"/>

                <TextBlock x:Name="StatusText" Margin="0,14,0,0"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource SmartLabMuted}"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="Authorized MIS staff only"
                   Style="{StaticResource SmartLabCaption}"
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>