<Window x:Class="SmartLab.Client.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Management"
        Width="1180"
        Height="720"
        MinWidth="980"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#081018"
        Foreground="#E9EEF2">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="USER MANAGEMENT" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Manage Student, Teacher, and Admin accounts" Margin="0,4,0,0" Foreground="#8B9AA5"/>
            </StackPanel>
            <Button x:Name="CloseButton" Content="CLOSE" Width="90" Height="34" HorizontalAlignment="Right" Click="CloseButton_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" Height="36" Padding="10" Background="#101C24" Foreground="#E9EEF2" BorderBrush="#2A3A45" TextChanged="SearchBox_TextChanged"/>
            <Button Grid.Column="1" Content="ADD ACCOUNT" Width="120" Height="36" Margin="8,0,0,0" Click="AddButton_Click"/>
            <Button Grid.Column="2" Content="REFRESH" Width="90" Height="36" Margin="8,0,0,0" Click="RefreshButton_Click"/>
        </Grid>

        <DataGrid x:Name="UsersGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  Background="#0A141B"
                  Foreground="#E9EEF2"
                  BorderBrush="#23333E"
                  RowBackground="#0C171E"
                  AlternatingRowBackground="#101C24"
                  GridLinesVisibility="Horizontal"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="70"/>
                <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="2*"/>
                <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="120"/>
                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="CREATED" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="160"/>
                <DataGridTemplateColumn Header="ACTIONS" Width="360">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="USERNAME" Width="82" Height="30" Margin="2" Tag="{Binding}" Click="RenameButton_Click"/>
                                <Button Content="ROLE" Width="58" Height="30" Margin="2" Tag="{Binding}" Click="RoleButton_Click"/>
                                <Button Content="PASSWORD" Width="82" Height="30" Margin="2" Tag="{Binding}" Click="PasswordButton_Click"/>
                                <Button Content="DELETE" Width="68" Height="30" Margin="2" Tag="{Binding}" Click="DeleteButton_Click"/>
                                <Button Content="RESTORE" Width="68" Height="30" Margin="2" Tag="{Binding}" Click="RestoreButton_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Text="Ready" Foreground="#8B9AA5"/>
    </Grid>
</Window>
