<Window x:Class="SmartLab.Client.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — User Management"
        Width="1260" Height="780" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="USER MANAGEMENT" Style="{StaticResource SmartLabPageTitle}"/>
                <TextBlock Text="Students, teachers, and administrators." Style="{StaticResource SmartLabCaption}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="1" Content="BACK"
                    Style="{StaticResource SmartLabBackButton}" Click="CloseButton_Click"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SmartLabToolbarBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Height="34"
                         ToolTip="Search username, Student Number, name, role, or status"
                         TextChanged="SearchBox_TextChanged"/>
                <Button Grid.Column="1" Content="IMPORT STUDENTS" Width="145" Margin="8,0,0,0"
                        Style="{StaticResource SmartLabPrimaryButton}" Click="ImportStudentsButton_Click"/>
                <Button Grid.Column="2" Content="ADD ACCOUNT" Width="122" Margin="8,0,0,0"
                        Click="AddButton_Click"/>
                <Button Grid.Column="3" Content="REFRESH" Width="90" Margin="8,0,0,0"
                        Click="RefreshButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SmartLabSectionBorder}" Padding="0">
            <DataGrid x:Name="UsersGrid" Style="{StaticResource SmartLabDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="58"/>
                    <DataGridTextColumn Header="STUDENT NO." Binding="{Binding StudentNumber}" Width="140"/>
                    <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="1.7*"/>
                    <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="1.2*"/>
                    <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="100"/>
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="95"/>
                    <DataGridTextColumn Header="PASSWORD STATUS" Binding="{Binding PasswordStatus}" Width="135"/>
                    <DataGridTextColumn Header="CREATED" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="145"/>
                    <DataGridTemplateColumn Header="ACTIONS" Width="360">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="USERNAME" Width="78" Height="29" Margin="2" Tag="{Binding}" Click="RenameButton_Click"/>
                                    <Button Content="ROLE" Width="54" Height="29" Margin="2" Tag="{Binding}" Click="RoleButton_Click"/>
                                    <Button Content="RESET" Width="60" Height="29" Margin="2" Tag="{Binding}" Click="PasswordButton_Click"/>
                                    <Button Content="DISABLE" Width="66" Height="29" Margin="2" Tag="{Binding}" Click="DeleteButton_Click"/>
                                    <Button Content="ENABLE" Width="66" Height="29" Margin="2" Tag="{Binding}" Click="RestoreButton_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="2,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource SmartLabCaption}"/>
            <TextBlock Grid.Column="1" Text="Imported students use Student Number as the initial password."
                       Style="{StaticResource SmartLabCaption}" FontSize="10"/>
        </Grid>
    </Grid>
</Window>