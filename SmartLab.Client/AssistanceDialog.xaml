<Window x:Class="SmartLab.Client.AssistanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLabSystem — Need Assistance"
        Width="560" Height="420" MinWidth="500" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartLabPageBackground}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Need Assistance" Style="{StaticResource SmartLabPageTitle}"/>
            <TextBlock Text="Send a classroom support request to the responsible staff." Style="{StaticResource SmartLabCaption}" Margin="0,3,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SmartLabSectionBorder}" Padding="20">
            <StackPanel>
                <TextBlock Text="CATEGORY" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}"/>
                <ComboBox x:Name="CategoryComboBox" Margin="0,6,0,16"/>
                <TextBlock Text="DESCRIPTION" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}"/>
                <TextBox x:Name="DescriptionTextBox" Height="150" Margin="0,6,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="CANCEL" Width="88" Height="34" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="SEND REQUEST" Width="128" Height="34" Style="{StaticResource SmartLabPrimaryButton}" Click="SendButton_Click"/>
        </StackPanel>
    </Grid>
</Window>