<Window x:Class="SmartLab.Client.AssistanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Need Assistance"
        Width="500" Height="370" MinWidth="460" MinHeight="330"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="REQUEST ASSISTANCE" Style="{StaticResource SmartLabPageTitle}" FontSize="19"/>
            <TextBlock Text="Send a concise request to your teacher or MIS."
                       Style="{StaticResource SmartLabCaption}" Margin="0,3,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="CATEGORY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}"/>
            <ComboBox x:Name="CategoryComboBox" Margin="0,5,0,0" SelectedIndex="0">
                <ComboBoxItem Content="General"/>
                <ComboBoxItem Content="Computer / Hardware"/>
                <ComboBoxItem Content="Network / Internet"/>
                <ComboBoxItem Content="Software"/>
                <ComboBoxItem Content="Account / Login"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="DESCRIPTION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}"/>
            <TextBox x:Name="DescriptionTextBox" Margin="0,5,0,0"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="CANCEL" Width="90" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="SEND REQUEST" Width="120" Style="{StaticResource SmartLabPrimaryButton}" Click="SendButton_Click"/>
        </StackPanel>
    </Grid>
</Window>