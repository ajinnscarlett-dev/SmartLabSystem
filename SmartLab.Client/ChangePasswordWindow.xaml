<Window x:Class="SmartLab.Client.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password"
        Width="430"
        Height="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="CHANGE PASSWORD"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#111827" />

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,18"
                   TextWrapping="Wrap"
                   Foreground="#4B5563"
                   Text="This account must change its password before continuing." />

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Current password"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Margin="0,0,0,5" />
            <PasswordBox x:Name="CurrentPasswordBox"
                         Height="34"
                         Padding="7" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="New password"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Margin="0,0,0,5" />
            <PasswordBox x:Name="NewPasswordBox"
                         Height="34"
                         Padding="7" />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Confirm new password"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Margin="0,0,0,5" />
            <PasswordBox x:Name="ConfirmPasswordBox"
                         Height="34"
                         Padding="7" />
            <TextBlock x:Name="StatusText"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="#B91C1C" />
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="CANCEL"
                    Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click" />
            <Button x:Name="SaveButton"
                    Content="CHANGE"
                    Width="100"
                    Height="32"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
