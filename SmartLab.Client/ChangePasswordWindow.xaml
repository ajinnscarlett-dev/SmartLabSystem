<Window x:Class="SmartLab.Client.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLabSystem — Change Password"
        Width="620" Height="500" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartLabPageBackground}">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Change Password" Style="{StaticResource SmartLabPageTitle}"/>
                <TextBlock Text="Update your authenticated SmartLab account password." Style="{StaticResource SmartLabCaption}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SmartLabSectionBorder}" Padding="24" MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="CURRENT PASSWORD" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}" VerticalAlignment="Center"/>
                <PasswordBox x:Name="CurrentPasswordBox" Grid.Row="0" Grid.Column="1" Margin="10,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="NEW PASSWORD" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}" VerticalAlignment="Center"/>
                <PasswordBox x:Name="NewPasswordBox" Grid.Row="1" Grid.Column="1" Margin="10,0,0,10"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="CONFIRM PASSWORD" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}" VerticalAlignment="Center"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="2" Grid.Column="1" Margin="10,0,0,10"/>

                <TextBlock Grid.Row="3" Grid.Column="1" Text="Minimum 6 characters. Server validation is required before the dialog closes."
                           Style="{StaticResource SmartLabCaption}" TextWrapping="Wrap" Margin="10,2,0,0"/>
                <TextBlock x:Name="StatusText" Grid.Row="4" Grid.Column="1" Foreground="{StaticResource SmartLabDanger}" TextWrapping="Wrap" Margin="10,10,0,0"/>

                <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                    <Button Content="CANCEL" Width="82" Height="34" Click="CancelButton_Click"/>
                </StackPanel>
                <Button x:Name="SaveButton" Grid.Row="4" Grid.Column="1" Content="CHANGE PASSWORD" Width="154" Height="34"
                        HorizontalAlignment="Right" Style="{StaticResource SmartLabPrimaryButton}" Margin="0,10,0,0" Click="SaveButton_Click"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="Password changes are enforced by the SmartLab Server." Style="{StaticResource SmartLabCaption}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
    </Grid>
</Window>