<Window x:Class="SmartLab.Client.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password"
        Width="430"
        Height="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}"
        FontFamily="Segoe UI">
    <Border Margin="20"
            Padding="24"
            Background="{StaticResource SmartLabSurface}"
            BorderBrush="{StaticResource SmartLabBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="CHANGE PASSWORD"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="1"
                       Margin="0,7,0,16"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SmartLabMuted}"
                       Text="This account must change its password before continuing." />

            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="Current password" FontWeight="SemiBold" Margin="0,0,0,5" />
                <PasswordBox x:Name="CurrentPasswordBox" Height="34" Padding="7" />
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock Text="New password" FontWeight="SemiBold" Margin="0,0,0,5" />
                <PasswordBox x:Name="NewPasswordBox" Height="34" Padding="7" />
            </StackPanel>
            <StackPanel Grid.Row="4">
                <TextBlock Text="Confirm new password" FontWeight="SemiBold" Margin="0,0,0,5" />
                <PasswordBox x:Name="ConfirmPasswordBox" Height="34" Padding="7" />
                <TextBlock x:Name="StatusText"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SmartLabDanger}" />
            </StackPanel>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="CANCEL" Width="90" Height="32" Margin="0,0,8,0" Click="CancelButton_Click" />
                <Button x:Name="SaveButton" Content="CHANGE" Width="100" Height="32" Style="{StaticResource SmartLabPrimaryButton}" Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
