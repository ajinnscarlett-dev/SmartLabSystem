<Window x:Class="SmartLab.Client.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password"
        Width="500" Height="470" MinWidth="500" MinHeight="470"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="CHANGE PASSWORD" Style="{StaticResource SmartLabPageTitle}"/>
            <TextBlock Text="Update the password for your authenticated SmartLab account."
                       Style="{StaticResource SmartLabCaption}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" MaxWidth="410" Padding="26"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Style="{StaticResource SmartLabSectionBorder}">
            <StackPanel>
                <TextBlock Text="CURRENT PASSWORD" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}"/>
                <PasswordBox x:Name="CurrentPasswordBox" Margin="0,6,0,16"/>

                <TextBlock Text="NEW PASSWORD" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}"/>
                <PasswordBox x:Name="NewPasswordBox" Margin="0,6,0,16"/>

                <TextBlock Text="CONFIRM NEW PASSWORD" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SmartLabMuted}"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,6,0,8"/>

                <TextBlock Text="Minimum 6 characters. The server confirms the change before the dialog closes."
                           Style="{StaticResource SmartLabCaption}" TextWrapping="Wrap"/>
                <TextBlock x:Name="StatusText" Margin="0,10,0,0"
                           Foreground="{StaticResource SmartLabDanger}" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="CANCEL" Width="90" Margin="0,0,8,0" Click="CancelButton_Click"/>
                    <Button x:Name="SaveButton" Content="CHANGE PASSWORD" Width="150"
                            Style="{StaticResource SmartLabPrimaryButton}" Click="SaveButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="Password changes are enforced by the SmartLab Server."
                   Style="{StaticResource SmartLabCaption}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
    </Grid>
</Window>