<Window x:Class="SmartLab.Client.TeacherLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Teacher Login"
        Width="460"
        Height="560"
        MinWidth="460"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}"
        FontFamily="Segoe UI">
    <Grid Margin="26">
        <Button Content="BACK"
                Width="78"
                Height="30"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="BackButton_Click"/>
        <Border Width="360"
                Padding="28"
                Background="{StaticResource SmartLabSurface}"
                BorderBrush="{StaticResource SmartLabBorder}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="SMARTLABSYSTEM" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Teacher Login" FontSize="13" Foreground="{StaticResource SmartLabMuted}" HorizontalAlignment="Center" Margin="0,4,0,24"/>
                <TextBlock Text="Username" FontWeight="SemiBold"/>
                <TextBox x:Name="UsernameTextBox" Margin="0,6,0,16"/>
                <TextBlock Text="Password" FontWeight="SemiBold"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,6,0,20"/>
                <Button x:Name="LoginButton"
                        Content="SIGN IN"
                        Style="{StaticResource SmartLabPrimaryButton}"
                        Height="42"
                        Click="LoginButton_Click"/>
                <TextBlock x:Name="StatusText"
                           Text=""
                           Margin="0,14,0,0"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{StaticResource SmartLabMuted}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
