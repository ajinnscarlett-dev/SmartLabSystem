<Window x:Class="SmartLab.Client.LiveScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Live Screen"
        Width="1150" Height="780" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SmartLabToolbarBorder}" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="LIVE SCREEN" Style="{StaticResource SmartLabPageTitle}" FontSize="19"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PcText" Text="PC: -" Style="{StaticResource SmartLabCaption}" Margin="0,3,10,0"/>
                        <TextBlock x:Name="StatusText" Text="Monitoring: OFF" Style="{StaticResource SmartLabCaption}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="StartStopButton" Grid.Column="1" Content="START MONITORING"
                        Width="170" Style="{StaticResource SmartLabPrimaryButton}" Click="StartStopButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#111820" BorderBrush="{StaticResource SmartLabBorderStrong}" BorderThickness="1">
            <Grid>
                <Image x:Name="ScreenImage" Stretch="Uniform"/>
                <StackPanel x:Name="NoScreenPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="NO LIVE SCREEN" Foreground="White" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Start monitoring to receive the selected PC's screen."
                               Foreground="#C7D0D8" FontSize="12" Margin="0,6,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="2,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="LastUpdateText" Text="Last frame: None"
                       Style="{StaticResource SmartLabCaption}" VerticalAlignment="Center"/>
            <Button x:Name="CloseButton" Grid.Column="1" Content="CLOSE" Width="82"
                    Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>