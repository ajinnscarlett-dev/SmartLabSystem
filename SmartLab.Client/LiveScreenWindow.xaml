<Window x:Class="SmartLab.Client.LiveScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Live Screen"
        Width="1100"
        Height="750"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartLabPageBackground}"
        Foreground="{StaticResource SmartLabText}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SmartLabSurface}"
                BorderBrush="{StaticResource SmartLabBorder}"
                BorderThickness="1"
                Padding="14"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="LIVE SCREEN" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PcText" Text="PC: -" FontSize="12" Foreground="{StaticResource SmartLabMuted}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="StatusText" Text="Monitoring: OFF" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" Foreground="{StaticResource SmartLabDanger}"/>
                </StackPanel>
                <Button x:Name="StartStopButton"
                        Grid.Column="1"
                        Content="START MONITORING"
                        Width="170"
                        Height="36"
                        Margin="15,0,0,0"
                        Style="{StaticResource SmartLabPrimaryButton}"
                        Click="StartStopButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#101820"
                BorderBrush="{StaticResource SmartLabBorderStrong}"
                BorderThickness="1">
            <Grid>
                <Image x:Name="ScreenImage" Stretch="Uniform"/>
                <StackPanel x:Name="NoScreenPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="No live screen available"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Start monitoring to view this PC's screen."
                               Foreground="#C7D0D8"
                               FontSize="12"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LastUpdateText"
                       Text="Last frame: None"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SmartLabMuted}"/>
            <Button x:Name="CloseButton"
                    Grid.Column="1"
                    Content="CLOSE"
                    Width="90"
                    Height="34"
                    Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
