<Window x:Class="SmartLab.Client.LiveScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLabSystem — Live Screen"
        Width="1180" Height="780" MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartLabPageBackground}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SmartLabToolbarBorder}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Live Screen" Style="{StaticResource SmartLabPageTitle}" FontSize="18"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PcText" Text="PC: -" Style="{StaticResource SmartLabCaption}" Margin="0,3,12,0"/>
                        <TextBlock x:Name="StatusText" Text="Monitoring: OFF" Style="{StaticResource SmartLabCaption}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="StartStopButton" Grid.Column="1" Content="START MONITORING" Width="172" Height="34" Style="{StaticResource SmartLabPrimaryButton}" Click="StartStopButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,10,0,0" Background="#111820" BorderBrush="{StaticResource SmartLabBorderStrong}" BorderThickness="1">
            <Grid>
                <Image x:Name="ScreenImage" Stretch="Uniform"/>
                <Border x:Name="NoScreenPanel" Background="#0E171F" Opacity="0.94" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="NO LIVE SCREEN" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Start monitoring to receive the selected workstation's screen." Foreground="#C5D0D8" FontSize="12" Margin="0,6,0,0" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="2,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="LastUpdateText" Text="Last frame: None" Style="{StaticResource SmartLabCaption}" VerticalAlignment="Center"/>
            <Button x:Name="CloseButton" Grid.Column="1" Content="CLOSE" Width="80" Height="34" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>