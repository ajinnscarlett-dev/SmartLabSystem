<Window x:Class="SmartLab.Client.LiveScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab - Live Screen"
        Width="1100"
        Height="750"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ==========================================
             HEADER
             ========================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock
                    x:Name="TitleText"
                    Text="Live Screen"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#182536"/>

                <TextBlock
                    x:Name="PcText"
                    Text="PC: -"
                    FontSize="15"
                    Margin="0,5,0,0"
                    Foreground="#65758A"/>

                <TextBlock
                    x:Name="StatusText"
                    Text="Monitoring: OFF"
                    FontSize="14"
                    FontWeight="Bold"
                    Margin="0,5,0,0"
                    Foreground="#C0392B"/>

            </StackPanel>


            <Button
                x:Name="StartStopButton"
                Grid.Column="1"
                Content="START MONITORING"
                Width="170"
                Height="40"
                Margin="15,0,0,0"
                FontWeight="Bold"
                Click="StartStopButton_Click"/>

        </Grid>


        <!-- ==========================================
             SCREEN PREVIEW
             ========================================== -->

        <Border
            Grid.Row="1"
            Background="Black"
            CornerRadius="8"
            BorderBrush="#D5DCE5"
            BorderThickness="1">

            <Grid>

                <Image
                    x:Name="ScreenImage"
                    Stretch="Uniform"/>


                <StackPanel
                    x:Name="NoScreenPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="No live screen available"
                        Foreground="White"
                        FontSize="22"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        Text="Start monitoring to view this PC's screen."
                        Foreground="#CCCCCC"
                        FontSize="14"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ==========================================
             FOOTER
             ========================================== -->

        <Grid
            Grid.Row="2"
            Margin="0,15,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <TextBlock
                x:Name="LastUpdateText"
                Text="Last frame: None"
                VerticalAlignment="Center"
                Foreground="#65758A"/>


            <Button
                x:Name="CloseButton"
                Grid.Column="1"
                Content="CLOSE"
                Width="110"
                Height="35"
                FontWeight="Bold"
                Click="CloseButton_Click"/>

        </Grid>

    </Grid>

</Window>