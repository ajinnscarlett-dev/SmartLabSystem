<Window x:Class="SmartLab.Client.TeacherAssistanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartLab — Assistance Queue"
        Width="1250" Height="700" MinWidth="950" MinHeight="500"
        Background="#F4F6F9" Foreground="#182536"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <DockPanel Margin="20">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="ASSISTANCE QUEUE" FontSize="24" FontWeight="Bold"/><TextBlock Text="Live requests from students in your authorized laboratories" Foreground="#65758A" Margin="0,3,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#65758A" Margin="0,0,12,0"/><Button Content="REFRESH" Width="100" Height="34" Click="Refresh_Click"/><Button Content="CLOSE" Width="90" Height="34" Margin="8,0,0,0" Click="Close_Click"/></StackPanel>
        </Grid>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="ACKNOWLEDGE" Width="115" Height="34" Margin="0,0,7,0" Click="Acknowledge_Click"/>
            <Button Content="IN PROGRESS" Width="110" Height="34" Margin="0,0,7,0" Click="Start_Click"/>
            <Button Content="RESOLVE" Width="90" Height="34" Margin="0,0,7,0" Click="Resolve_Click"/>
            <Button Content="CLOSE" Width="75" Height="34" Click="CloseRequest_Click"/>
        </WrapPanel>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions>
            <DataGrid x:Name="QueueGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="QueueGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Student" Binding="{Binding StudentUsername}" Width="130"/>
                    <DataGridTextColumn Header="PC" Binding="{Binding PCNumber}" Width="90"/>
                    <DataGridTextColumn Header="Laboratory" Binding="{Binding LaboratoryName}" Width="130"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/>
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="150"/>
                    <DataGridTextColumn Header="Issue" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="1" Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="SelectedRequestText" FontWeight="Bold" Foreground="#182536"/>
                    <TextBlock x:Name="ResolutionText" Grid.Row="1" TextWrapping="Wrap" Foreground="#4B5D70" Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
