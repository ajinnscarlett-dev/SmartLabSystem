{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=SmartLabDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Jwt": {
    "Issuer": "SmartLab",
    "Audience": "SmartLab.Client"
  },

  "SmartLab": {
    "HeartbeatTimeoutSeconds": 20,
    "MonitorIntervalSeconds": 5
  },

  "AllowedHosts": "*"
}
